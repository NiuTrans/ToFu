# ── Secrets & Environment ──
.env
.env.*
!.env.example

# Repository guidance is source even when a local Git exclude hides it.
!/AGENTS.md

# ── Per-host env marker (written by install.sh, read by server.py
#    / bootstrap.py to re-exec into the correct conda interpreter).
#    Contains absolute paths — machine-specific, never commit. ──
.tofu_env.json

# ── Migration backups ──
.migrate_backup/
load_env.py

# ── Self-update backups (originals of files replaced by the tarball-overlay
#    updater for non-git deployments; reversible safety net, machine-local). ──
.update_backup/

# ── Data-cleanup leftovers (large stray artifacts at repo root, e.g. the
#    276MB delete.list.all.final; not part of the app, exceed GitHub's
#    100MB limit and break export/push — see export-large-stray-file note). ──
/delete.list*

# ── Python ──
__pycache__/
*.pyc
*.pyo
# Python distribution metadata is generated by package builds.
*.egg-info/

# Local interpreters and test-run state.  Modern venv/pytest versions create
# nested .gitignore files themselves, but the repository boundary must not
# depend on a tool having initialized those directories successfully.
/.venv/
/venv/
/.texlive/
/.pytest_cache/
/.hypothesis/

# ── Agent/session plumbing and local scratch (never source) ──
# .worktrees/ holds nested Git checkouts spawned by harness sessions; .agents/
# holds locally installed skill packages; .tmp/, tmp/ and work/ are ad-hoc
# session scratch (audit payloads, baselines). Root-anchored so nested
# packages named tmp/work elsewhere stay visible.
/.worktrees/
# Native build probes, session receipts and pre-integration backups.
/.native/
# .agents/ holds locally installed skill packages and session plumbing —
# ignore its CONTENTS, but not the first-party repo dev guides under
# skills/: tests/skills/test_skill_channel.py asserts their content, so clean
# checkouts (worktrees, CI, the opensource export) must carry them.
# (A bare `/.agents/` would make re-inclusion impossible: git never
# descends into an excluded directory.)
/.agents/*
!/.agents/skills/
/.tmp/
/tmp/
/work/
# Literal `$DEST` dirs appear when a packaging script copies into an
# unexpanded "$DEST" variable (one rode in on 84a6662e8); never source.
/$DEST/


# ── Runtime data (auto-created, contains databases, configs, temp files) ──
# ROOT-ANCHORED on purpose: a bare `data/` matches a nested `data` dir at ANY
# depth, and it silently swallowed NEW untracked files under
# android/app/src/.../client/data/ (the android Room package — the 3 existing
# files survive only because they are tracked). Anchored to the repo root, the
# runtime dir stays ignored without hiding legitimate nested `data` packages.
/data/
# Runtime scratch under lib/ (tmp/, tool-results/) — rode the old unanchored
# rule; kept ignored explicitly.
/lib/data/
# ── Database ──
*.db

# ── Internal analysis (not part of the app) ──
/analysis_scripts/
/sundries/
/tools/
# External Codex source checkout used for local comparison/evaluation.
/codex/

# ── Academic / personal scratch content (NOT part of the app — must never
#    be published to the public mirror). overleaf_cache holds fetched
#    Overleaf projects (real unpublished papers/theses); paper/ holds a
#    paper draft; thesis_references.bib is a personal bib file. ──
/overleaf_cache/
/paper/
/thesis_references.bib

# Separate internal LongCat harness workspace. Its own AGENTS.md explicitly
# marks links/data as company-internal; keep it on disk but outside Tofu's Git
# baseline and every Tofu export.
/autoharness/

# ── Personal scratch copy script (not part of the app) ──
/copy_to_chenxin.sh

# ── Export-stripped / not-part-of-the-public-product (DRIFT-GUARDED) ──
# These are excluded by export.py (ALWAYS_EXCLUDE_* / OPENSOURCE_EXTRA_EXCLUDE_*)
# but were committed BEFORE a matching ignore existed. .gitignore is the SECOND
# defense line (export is the publication gate / first line); the drift-guard
# tests/meta/test_gitignore_covers_export_excludes.py asserts the two lists stay in
# sync so this gap cannot silently reopen. Documented keepers stay tracked:
#   scripts/gen_desktop_icons.py (CI icon gen), export.py, CLAUDE.md,
#   bundles/yourprovider/provider_templates/yourprovider.json (functional internal template),
#   scripts/package_extension.sh (builds the store upload zip; the SHIPPED
#     docs/chrome-web-store/ kit tells the reader to run it, so a clean clone
#     without it makes that instruction a dead end),
#   scripts/install_on_server.sh (server-side installer; same shape — a
#     documented entry point that must exist in a clean clone to be runnable).
# Benchmark result payloads remain local, but executable benchmark contracts
# imported by the release test suite must exist in a clean clone.
/benchmarks/
