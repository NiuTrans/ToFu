build/
dist/
*.spec.bak
installer_output/
static/icons/tofu.ico
static/icons/tofu.icns
static/icons/installer/
.icon-backups/
# AI assistant evolution journal (per-developer, not source)
JOURNAL.md
# Context-efficiency run logs and patches (generated; manifest stays tracked)
benchmarks/context_efficiency_results/
# AI assistant runtime artifacts (file-history, trash, sandbox)
.tofu*

