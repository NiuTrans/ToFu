# chatui horizontal-scale ingress example
#
# The browser derives X-Tofu-Affinity-Key before each task-creation POST
# (stable per conversation; random only for conversation-less tasks) and
# reuses it for SSE, poll and abort. Hash this header at ingress so creation,
# branches/children and every follow-up reach the same in-memory owner.
# Replace the two server names with independently supervised replicas. Each
# replica must run one server.py process and have a unique TOFU_REPLICA_ID.

map $http_x_tofu_affinity_key $tofu_affinity_key {
    default $http_x_tofu_affinity_key;
    ""      $binary_remote_addr;
}

map $http_upgrade $tofu_connection_upgrade {
    default upgrade;
    ""      close;
}

upstream chatui_replicas {
    hash $tofu_affinity_key consistent;
    server chatui-1:15000;
    server chatui-2:15000;
    keepalive 64;
}

server {
    listen 443 ssl http2;
    server_name chatui.example.com;

    # Use a publicly/device-trusted certificate at the ingress. The app's
    # development self-signed certificate is not suitable for fleet ingress.
    ssl_certificate     /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;

    location / {
        proxy_pass http://chatui_replicas;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Tofu-Affinity-Key $http_x_tofu_affinity_key;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $tofu_connection_upgrade;

        # SSE must be delivered incrementally and never transformed/buffered.
        proxy_buffering off;
        proxy_cache off;
        gzip off;
    }
}
