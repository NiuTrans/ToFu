{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Installed Tofu repository grammar bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "registry_version",
    "libraries"
  ],
  "properties": {
    "format": {
      "const": "tofu.repo-grammar-bundle/v1"
    },
    "registry_version": {
      "const": "1.20.0"
    },
    "libraries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/library"
      }
    }
  },
  "$defs": {
    "library": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "bytes",
        "sha256"
      ],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^libtree_sitter_[A-Za-z0-9_]+\\.so$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775806
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
