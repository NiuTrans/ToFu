              "capability_id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 18446744073709551615
              }
            }
          }
        }
      }
    }
  },
  "daemonTransport": {
    "format": "tofu.native-checkpoint-transport/v1",
    "capabilitiesOperation": "native_checkpoint.capabilities",
    "controlOperation": "native_checkpoint.control",
    "lifecycle": "One authenticated selected authority; volatile runtime_id fences capability IDs across process restart. No automatic retry. Joined listener workers own all callbacks.",
    "responseLimitSource": "contracts/storage_v2.json streamedResponses u32 chunk index representation; caller response preflight precedes effects and existing frame owners admit each chunk",
    "requestSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "runtime_id",
        "operation",
        "payload",
        "response_bytes"
