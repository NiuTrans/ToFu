            "load",
            "begin",
            "complete",
            "seal",
            "release",
            "forget",
            "finish",
            "recover",
            "handoff",
            "pending",
            "invoice",
            "frontier",
            "goal_claim",
            "goal_handoff"
          ]
        },
        "payload": {
          "type": "object"
        },
        "response_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
