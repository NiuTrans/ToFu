{
  "experiment": "portable one-shot replies under the accepted embedded mimalloc allocator",
  "date": "2026-10-05",
  "decision": "Rejected for publication; retain the standard one-shot MPSC response. Only this decision/evidence is integrated. The prototype remains in a private Git commit.",
  "problem": "Whether response allocation and endpoint retirement remain a dominant read bottleneck after the accepted allocator/completion-ready improvements, without comparing different native binaries.",
  "alternatives": [
    "Retain standard MPSC replies; chosen because the portable cell has repeated concurrent latency/tail regressions in the matched-binary cohort.",
    "Unique atomic value slot with Mutex-protected Thread waiter and standard park/unpark; implemented and checked here.",
    "Older direct futex prototype; not reused as an implementation. All raw syscalls removed because its wake/filter error boundary was not established.",
    "Immutable waiter shortcut; not used. A timed-out receiver can move to another thread before retry; an explicit test preserves that capability."
  ],
  "implementation": {
    "private_baseline_commit": "e856c0f0dce7664384b242bef633f78aab42d162",
    "private_prototype_commit": "f2e801f756bda80697366484ef9921caa891a49c",
    "source_sha256": "c9f4fd09b44c14d41c42a629fefd627e2891b3610d224ff700f7057806ab1ca6",
    "raw_syscalls": false,
    "protocol": "Unique non-cloneable producer; Release/Acquire READY publication; non-Sync receiver; endpoint Arcs retain result ownership; cancellation/late/unread result drops exactly once; waiter re-registration preserves Receiver Send. Standard reply is private prototype default.",
    "private_observer_abi": "tofudb_embed_reply_backend_kind returns the actual process-selected OnceLock backend; verified before each measured leg. Not a production ABI addition.",
    "private_control": "TOFU_DB_REPLY_BACKEND standard/portable only in synthetic child processes. No user or application environment was changed."
  },
