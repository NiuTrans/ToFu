  "resource_design": {
    "capacity": "1/256 of the existing block-cache capacity supplied by the same launch probe; no eager index allocation. Explicit zero disables reuse.",
    "scope": "Each authority owns one cache; published/direct replicas share it. Identity uses tenant/owner/hash plus full raw payload equality, and only the exact immutable generic VersionedDocumentGet IR is eligible.",
    "resident_accounting": "Payload, actual IR string/vector/key capacities and conservative per-entry index/deque/Arc metadata are charged. Evicted externally leased entries stay charged until the last Arc drops. Empty/disabled roots release index/deque allocations.",
    "contention": "Nonblocking read/write acquisition declines to the original compiler; poisoned reconstructible metadata also declines. No new worker, queue, persisted state, source/result cache, deadline widening or transport bypass."
  },
  "source_proofs": [
    "Exact hit skips compiler; different owner and full raw bytes compile independently.",
    "Duplicate keys retain last-wins semantics; malformed and out-of-range numeric payloads are rejected.",
    "Task-result codec and query command IDs are not cached.",
    "Capacity exhaustion cannot overcommit retained external plans; disabled roots release metadata.",
    "Contention and poison retain original compiler behavior.",
    "Cached plans return current values across update/delete and retain execution deadline errors."
  ],
  "next_action": "Move to dominant transport publication/wake and read-facade construction costs; retain worker watchdog, buffer ownership, no-spin behavior and default-off CPU controls. Repeated compilation is a secondary target here, not proof of the full SQLite gap.",
