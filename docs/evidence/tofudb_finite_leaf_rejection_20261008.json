  "reproducer": "from pathlib import Path\nimport sys,ast,time,json,hashlib\nroot=Path.cwd();sys.path.insert(0,str(root));p=root/'.tmp/tofudb-finite-leaf-20261008';w=Path('/tmp/tofudb-finite-leaf-20261008')\nfrom lib.storage import protocol\nsources={'baseline':p/'lib__storage__protocol.py.before','candidate':w/'lib/storage/protocol.py'};functions={}\nfor label,path in sources.items():\n tree=ast.parse(path.read_text());node=next(n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name=='validate_finite_json_numbers');namespace=dict(protocol.__dict__);exec(compile(ast.Module(body=[node],type_ignores=[]),label+'-finite-admission','exec'),namespace);functions[label]=namespace['validate_finite_json_numbers']\ncases=[('flat-read',300000,{'namespace':'worker','key':'one','user_id':11}),('nested-put',100000,{'namespace':'worker','key':'one','value':{'n':1,'text':'small'},'user_id':11}),('stream-event',50000,{'task_id':'one','sequence':1,'event':{'type':'assistant.delta','text':'x'*8192,'tool_calls':[]},'user_id':11}),('array-512',1000,{'items':[{'n':n,'label':str(n)} for n in range(512)]})]\nrows=[]\nfor index,label in enumerate(['baseline','candidate','candidate','baseline','candidate','baseline','baseline','candidate']):\n for name,iterations,value in cases:\n  function=functions[label]\n  for _ in range(100):function(value)\n  cpu=time.process_time_ns();wall=time.perf_counter_ns()\n  for _ in range(iterations):function(value)\n  elapsed=time.perf_counter_ns()-wall;cpu=time.process_time_ns()-cpu\n  row={'index':index,'variant':label,'case':name,'iterations':iterations,'mean_ns':elapsed/iterations,'cpu_ns_per_call':cpu/iterations};rows.append(row);print(label,name,round(elapsed/iterations),flush=True)\n(p/'micro-results.json').write_text(json.dumps({'rows':rows,'source_sha256':{k:hashlib.sha256(v.read_bytes()).hexdigest() for k,v in sources.items()},'scope':'Exact retained validation functions; finite inputs, no encoding or database. Fixed closed corpus, eight or