{
  "name": "tofu-frontend-typecheck",
  "version": "0.1.0",
  "description": "Tofu vanilla frontend checks and incremental Vite/TypeScript module build.",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20.19 <21"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:modules": "tsc -p tsconfig.vite.json --noEmit",
    "typecheck:count": "tsc --noEmit --pretty false 2>&1 | grep -c 'error TS' || true",
    "generate:runtime": "node scripts/compose_frontend_runtime.mjs --write",
    "check:runtime": "node scripts/compose_frontend_runtime.mjs --check && node scripts/check_lazy_runtime_bindings.mjs && node scripts/check_runtime_reachability.mjs",
    "generate:styles": "node scripts/compose_frontend_styles.mjs --write",
    "check:styles": "node scripts/compose_frontend_styles.mjs --check",
    "generate:conversation-sync": "python3 scripts/gen_conversation_sync_contract.py",
    "check:conversation-sync": "python3 scripts/gen_conversation_sync_contract.py --check",
    "generate:api-v4": "python3 scripts/gen_api_v4_contract.py",
    "check:api-v4": "python3 scripts/gen_api_v4_contract.py --check",
    "generate:i18n": "node scripts/gen_i18n_contract.mjs --write",
    "check:i18n": "node scripts/gen_i18n_contract.mjs --check && node scripts/check_i18n_usage.mjs",
    "generate:actions": "node scripts/update_runtime_actions.mjs --write",
    "check:actions": "node scripts/update_runtime_actions.mjs --check",
    "build:frontend": "node scripts/build_frontend.mjs",
    "build:frontend:raw": "vite build",
    "verify:frontend": "python3 scripts/verify_frontend_dist.py",
    "dev:frontend": "vite --host 127.0.0.1",
    "check:frontend": "npm run check:runtime && npm run check:styles && npm run check:conversation-sync && npm run check:api-v4 && npm run check:i18n && npm run check:actions && npm run typecheck:modules && npm run build:frontend"
  },
  "keywords": [],
  "license": "MIT",
  "devDependencies": {
    "dompurify": "^3.4.13",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.1"
  },
  "dependencies": {
    "highlight.js": "^11.9.0",
    "html2canvas": "^1.4.1",
    "katex": "^0.16.22",
    "marked": "^12.0.2",
    "pdfjs-dist": "^4.10.38"
  }
}
