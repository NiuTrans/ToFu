{
  "name": "tofu-frontend-typecheck",
  "version": "0.1.0",
  "description": "Tofu vanilla frontend checks and incremental Vite/TypeScript module build.",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20.19 <21"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:modules": "tsc -p tsconfig.vite.json --noEmit",
    "test:unit": "vitest run",
    "generate:runtime": "node scripts/compose_frontend_runtime.mjs --write",
    "check:runtime": "node scripts/compose_frontend_runtime.mjs --check && node scripts/check_lazy_runtime_bindings.mjs && node scripts/check_runtime_reachability.mjs && node scripts/check_frontend_tdz.mjs",
    "generate:styles": "node scripts/compose_frontend_styles.mjs --write",

    "generate:settings-panels": "node scripts/compose_settings_panels.mjs",
    "check:settings-panels": "node scripts/compose_settings_panels.mjs --check",
    "check:styles": "node scripts/compose_frontend_styles.mjs --check && node scripts/check_style_tokens.mjs && node --test tests/timer_style_ownership.test.cjs",
    "generate:conversation-sync": "python3 scripts/gen_conversation_sync_contract.py",
    "check:conversation-sync": "python3 scripts/gen_conversation_sync_contract.py --check",
    "generate:paper-build": "python3 scripts/generate_paper_build_contract.py",
    "check:paper-build": "python3 scripts/generate_paper_build_contract.py --check",
    "generate:api-v4": "python3 scripts/gen_api_v4_contract.py",
    "check:api-v4": "python3 scripts/gen_api_v4_contract.py --check",
    "generate:api-v1-model-routing": "python3 scripts/gen_api_v1_model_routing_contract.py",
    "check:api-v1-model-routing": "python3 scripts/gen_api_v1_model_routing_contract.py --check",
    "generate:event-contract": "python3 scripts/gen_event_contract.py",
    "check:event-contract": "python3 scripts/gen_event_contract.py --check",
    "generate:i18n": "node scripts/gen_i18n_contract.mjs --write",
    "check:i18n": "node scripts/gen_i18n_contract.mjs --check && node scripts/check_i18n_usage.mjs",
    "generate:note-presentation": "node scripts/gen_system_note_presentation.mjs --write",
    "check:note-presentation": "node scripts/gen_system_note_presentation.mjs --check && node scripts/check_note_presentation_parity.mjs",
    "generate:actions": "node scripts/update_runtime_actions.mjs --write",
    "check:actions": "node scripts/update_runtime_actions.mjs --check",
    "build:frontend": "node scripts/build_frontend.mjs",
    "build:frontend:raw": "vite build",
    "verify:frontend": "python3 scripts/verify_frontend_dist.py",
    "dev:frontend": "vite --host 127.0.0.1",
    "check:research": "node --test frontend/src/features/evolution/research/testing/*.test.cjs",
    "check:model-picker": "node --test tests/model_picker.test.cjs",
    "check:application-interactions": "node --test tests/application_interactions.test.cjs",
    "check:renderer-boundaries": "node --test tests/conversation_renderer_boundaries.test.cjs tests/tool-group-presentation.test.cjs && node scripts/check_conversation_renderer_boundaries.mjs",
    "check:tool-header": "python3 -m pytest -q tests/tools/test_tool_header_presentation.py tests/tools/test_tool_display_readability.py tests/tasks_pkg/test_gate_refusal_meta.py tests/frontend/test_frontend_tool_rounds_wire_parity.py",
    "check:frontend": "npm run check:settings-panels && npm run check:tool-result-surfaces && npm run check:runtime && npm run check:styles && npm run check:model-context && npm run check:conversation-sync && npm run check:automation && npm run check:paper-build && npm run check:api-v4 && npm run check:api-v1-model-routing && npm run check:event-contract && npm run check:i18n && npm run check:actions && npm run check:ui-nav && npm run check:renderer-boundaries && npm run check:application-interactions && npm run check:model-picker && npm run typecheck:modules && npm run build:frontend",
    "generate:ui-nav": "node scripts/gen_ui_nav_targets.mjs --write",
    "check:ui-nav": "node scripts/gen_ui_nav_targets.mjs --check",
    "generate:automation": "python3 scripts/gen_automation_contract.py",
    "check:automation": "python3 scripts/gen_automation_contract.py --check",
    "check:tool-result-surfaces": "python3 scripts/gen_tool_result_surfaces.py --check",
    "check:model-context": "python3 scripts/gen_model_context_projection.py --check"
  },
  "keywords": [],
  "license": "MIT",
  "devDependencies": {
    "dompurify": "^3.4.13",
    "jsdom": "^25.0.1",
    "postcss": "8.5.26",
    "typescript": "^5.9.3",
    "vite": "^7.1.1",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@awesome.me/webawesome": "^3.13.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "highlight.js": "^11.9.0",
    "html2canvas": "^1.4.1",
    "katex": "^0.16.22",
    "marked": "^12.0.2",
    "pdfjs-dist": "^4.10.38"
  }
}
