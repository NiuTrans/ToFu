# ═══════════════════════════════════════════════════════════════
#  Tofu (豆腐) — Environment Configuration
# ═══════════════════════════════════════════════════════════════
#
#  Copy this file to .env and fill in your values:
#
#    cp .env.example .env
#
#  Then start the server:
#
#    python server.py
#
#  Priority: Settings UI > environment variables > defaults
#  (Any setting you configure in the web UI takes precedence)
#
#  Lines starting with # are comments. Remove # to enable a variable.
# ═══════════════════════════════════════════════════════════════


# ── Published developer runtime / sidecar ──────────────────────
# These are the complete happy-path model settings for `tofu-agent`.
# Configure them once on the sidecar; downstream SDK callers then need only
# its URL and TOFU_AGENT_TOKEN and may omit a model on every request.
# TOFU_AGENT_PROVIDER_BASE_URL=https://api.openai.com/v1
# TOFU_AGENT_PROVIDER_API_KEY=sk-your-key-here
# TOFU_AGENT_PROVIDER_MODEL=gpt-5.6
# TOFU_AGENT_PROVIDER_EXTRA_HEADERS={"X-Provider-Header":"value"}
#
# The CLI defaults to loopback:15001. A remote/container bind is refused
# without a token unless the explicit unsafe CLI override is used.
# TOFU_AGENT_HOST=127.0.0.1
# TOFU_AGENT_PORT=15001
# TOFU_AGENT_TOKEN=replace-with-a-long-random-secret
# TOFU_AGENT_MAX_INFLIGHT=4


# ── LLM Provider ──────────────────────────────────────────────
# The easiest way is to configure via Settings UI (⚙️ → Providers).
# These env vars serve as fallback for headless / Docker deployments.

# API key (required — comma-separated for multiple keys)
# LLM_API_KEYS=sk-key1,sk-key2,sk-key3

# Single key (legacy, works too)
# LLM_API_KEY=sk-your-key-here

# API endpoint (default: https://api.openai.com/v1)
# LLM_BASE_URL=https://api.openai.com/v1

# Default model (default: gpt-4o)
# LLM_MODEL=gpt-4o

# Rolling upstream stream-idle window (default: 300 seconds). Any received SSE
# bytes/comment/keep-alive or WebSocket message renews it; this is not a total
# request deadline. Set 0 to disable. The old SEMANTIC_IDLE/NO_ACTIONABLE names
# are deprecated aliases and no longer impose a semantic-progress deadline.
# TOFU_LLM_IDLE_STREAM_TIMEOUT_S=300

# Fallback model — used when the primary model fails (default: disabled)
# FALLBACK_MODEL=gpt-4o-mini

# Optional continuous all-slot 429 ceiling before the current model escalates
# to the fallback boundary (default: 0, disabled — wait until recovery/cancel).
# Set a positive value only when deliberately opting into bounded escalation.
# TOFU_429_SATURATION_SECS=120

# Keep remote provider model catalogues current from their authenticated
# /models endpoint (default: enabled). New models are added automatically;
# a missing model is retired only after two successful consecutive snapshots.
# Failed/empty responses always keep the last-good list. Per-provider control
# is also available in Settings → Providers.
# TOFU_MODEL_CATALOG_SYNC=1
# TOFU_MODEL_CATALOG_SYNC_INTERVAL=21600
# TOFU_MODEL_CATALOG_REMOVE_AFTER=2

# Artificial Analysis capability scores in Settings → Models (optional).
# The key is normally configured graphically in Settings → Models (encrypted,
# owner-scoped, effective immediately, no restart). This variable is only the
# headless bootstrap fallback used when no key has been saved through the UI;
# a UI-saved key always wins over it.
# Register a free key at https://artificialanalysis.ai/ (x-api-key header;
# the external API is rate-limited). The dataset is fetched lazily and cached
# for 24h under the data root; redisplay in the panel carries AA attribution as
# their terms require. An unset key hides the badges — the rest of the panel
# is unaffected.
# TOFU_AA_API_KEY=
# TOFU_AA_CACHE_TTL_SECONDS=86400

# ── Agent-loop context economy ──

# Maximum repeatedly replayed prompt working set before automatic structured
# compaction (default: 128000 tokens). This is intentionally lower than a 1M
# model's hard context window because cache reads still cost money and time.
# Set 0 to restore the old context-window-only trigger.
# TOFU_WORKING_CONTEXT_TOKENS=128000

# MCP schema exposure. The default is intent-based preselection: each request
# exposes at most mcpActiveToolLimit (default 8) native MCP schemas matched to
# the latest user turn, so a large connected catalog neither floods the LLM
# with hundreds of schemas nor becomes full-resident. Set mcpToolExposure=inline
# to expose every enabled MCP schema, or mcpToolExposure=progressive for the
# legacy three discovery/read/write meta-tool surface. These are request-config
# keys (mcpToolExposure / mcpActiveToolLimit); no TOFU_* environment variable
# drives them.

# Unified project editor (default: enabled). It exposes one edit_file tool with
# replace/insert_before/insert_after operations instead of four competing edit
# schemas. Set to 0 for an immediate compatibility rollback to the legacy tools.
# TOFU_UNIFIED_EDIT_TOOL=1

# ── Project Brain deterministic Git integration ──
# Background worker is enabled by default. Set 0 only for maintenance/manual
# processing; idle polls are read-only.
# TOFU_INTEGRATION_AUTORUN=1
# TOFU_INTEGRATION_IDLE_POLL_MAX_SECONDS=60
# TOFU_INTEGRATION_WORKSPACE_DIR=/absolute/local/path/to/integration-worktrees
#
# Semantic code/config changes fail closed unless this direct argv command is
# configured. It runs in a detached worktree at the exact candidate tree.
# Shell operators such as && are not interpreted; point to one script when a
# multi-step gate is needed.
# This repository can use its affected-test selector. {base}/{target} are
# replaced with immutable SHAs without invoking a shell:
# TOFU_INTEGRATION_TEST_CMD=python3 scripts/test_select.py --base {base} --run --jobs 4
# TOFU_INTEGRATION_TEST_TIMEOUT=3600
#
# Optional additional gate for candidate -> stable promotion. The candidate
# gate remains mandatory for semantic code/config changes even when this is
# unset.
# TOFU_INTEGRATION_STABLE_TEST_CMD=make ci
# TOFU_INTEGRATION_STATUS_SCAN_LIMIT=8

# ── Single-checkout linear Git checkpoints (explicit opt-in) ──
# Use this for model-only development where per-task worktrees/merges cost more
# than they save. Project tools never consult this setting. After a task ends,
# a background observer snapshots the current workspace on the current branch;
# concurrent edits are coalesced and later bytes remain for the next snapshot.
# No worktree or merge is created. Prefer the repository-local switch
# (`git config --local tofu.linearCheckpoint true`) so unrelated attached
# projects are never auto-committed. The environment switch enables the mode
# for every attached Git project in this server process.
# TOFU_LINEAR_GIT_CHECKPOINT=0
# TOFU_LINEAR_GIT_CHECKPOINT_LOCK_WAIT_SECONDS=30
#
# Semantic code/config checkpoints become publishable (`refs/tofu/stable`)
# only after this direct argv command passes. {base}/{target} are immutable
# SHAs; no shell operators are interpreted. If unset, the integration test
# command above is reused. A gate that rewrites non-ignored source fails.
# TOFU_LINEAR_GIT_CHECKPOINT_TEST_CMD=python3 scripts/test_select.py --base {base} --run --jobs 4
# TOFU_LINEAR_GIT_CHECKPOINT_TEST_TIMEOUT=3600
#
# After the first task-end snapshot activates the linear baseline, export
# selects refs/tofu/stable automatically. The opt-in bit alone still exports
# HEAD, so an older isolated-mode stable ref cannot regress a newly enabled
# repository. This override (or `git config tofu.exportRef <ref>`) pins another
# explicit ref.
# TOFU_EXPORT_SOURCE_REF=refs/tofu/stable


# ── Server ────────────────────────────────────────────────────

# Server port (default: 15000, auto-increments if occupied)
# PORT=15000

# Bind address (default: 0.0.0.0 — all interfaces; the desktop-agent
# LAN pairing flow relies on it). Set 127.0.0.1 to bind loopback only.
# BIND_HOST=0.0.0.0

# Flask debug mode (default: 0)
# FLASK_DEBUG=0

# Listener TLS is opt-in. Keep the origin on HTTP behind Codelab, VS Code,
# JupyterHub, nginx, Caddy, Kubernetes ingress, or any proxy that terminates
# HTTPS. For a direct HTTPS listener, set TOFU_TLS=1; a development certificate
# is generated when no TLS_CERTFILE/TLS_KEYFILE pair is configured.
# TOFU_TLS=0

# Development TLS certificate SANs (comma-separated DNS names or IPs).
# The auto-generated certificate always includes localhost, loopback, the
# machine hostname and discovered local addresses. Delete data/certs/tofu.*
# once after changing this list so the development certificate is regenerated.
# For production/LAN fleets, terminate TLS at an ingress with a certificate
# trusted by every client device instead of distributing this self-signed cert.
# TOFU_TLS_SANS=tofu.lan,192.168.1.20

# Generic outbound HTTP connection-pool bounds (does not change request or
# LLM-stream timeouts). One requests pool is kept per worker thread and one
# httpx pool per event loop/proxy/TLS policy.
# TOFU_HTTP_POOL_MAX_CONNECTIONS=64
# TOFU_HTTP_POOL_MAX_KEEPALIVE=20


# ── Deployment and storage authority ──────────────────────────
# Personal mode is the zero-configuration default: one process role and the
# project-local SQLite authority. Docker Compose and install.sh use this mode.
# TOFU_DEPLOYMENT_MODE=personal
# TOFU_PROCESS_ROLE=all
#
# Distributed mode is deployed through Kubernetes and requires all six values
# below. PostgreSQL/Redis credentials are mounted files, never plaintext env
# values. PostgreSQL must include sslmode=verify-full and Redis must use rediss.
# TOFU_DEPLOYMENT_MODE=distributed
# TOFU_DISTRIBUTED_PREVIEW_MODE=read-only
# TOFU_PROCESS_ROLE=api
# TOFU_POSTGRES_DSN_FILE=/run/secrets/tofu-postgres-dsn
# TOFU_REDIS_URL_FILE=/run/secrets/tofu-redis-url
# TOFU_REPLICA_ID=tofu-api-0
#
# Only the TOFU_* namespace is accepted. Every CHATUI_* variable, every
# TOFU_DB_* variable, TOFU_REQUIRE_PG, TOFU_REPLICA_RING, and
# TOFU_STORAGE_MODE is rejected at startup instead of being aliased or used to
# guess a storage authority.
#
# Unset personal-mode resource controls are derived once at process launch.
# Effective CPU is min(host, affinity/cpuset, cgroup quota); memory uses host
# MemAvailable plus an explicit cgroup limit/headroom; log retention and the
# startup reserve see the resolved data volume (including TOFU_DATA_DIR / XDG
# layout), not merely the source checkout. One concurrency unit requires 2 GiB
# effective capacity and 1 GiB currently available. `python serverctl.py doctor` prints
# both the probe evidence and the resulting defaults. Explicit values below
# always win.

# Sidecar pools. PostgreSQL's combined request is capped to 80% of the server
# connection budget; SQLite always has exactly one writer connection.
# Personal query/RPC pools adapt together from 2..12; an 8-CPU, 8-GiB machine
# with at least 4 GiB available resolves to 8. Distributed mode defaults to 64
# RPCs and retains the larger PostgreSQL pools below.
# TOFU_STORAGE_SQLITE_READ_POOL=8
# Waiting SQLite writes have a separate total job ceiling (personal probe:
# 8..64; 16 on the reference host; distributed: 128; hard ceiling: 1024).
# Timed-out jobs are removed immediately so their request payloads are freed.
# TOFU_STORAGE_SQLITE_WRITER_QUEUE_CAPACITY=16
# Durable task events derive their waiting-object budget from that same launch
# probe (probe-failure: 256; 8 GiB reference: 512; distributed: 4096). The
# waiting queue is also byte-bounded (64 MiB fallback/reference, 512 MiB
# distributed), while one Sidecar batch stays below the 64 MiB storage frame.
# Explicit item/queue/batch values have hard ceilings of 8192 / 1024 MiB /
# 60 MiB; lowering the batch limit also lowers the maximum individual event.
# TOFU_STORAGE_EVENT_QUEUE_CAPACITY=512
# TOFU_STORAGE_EVENT_QUEUE_MAX_MIB=64
# TOFU_STORAGE_EVENT_BATCH_MAX_MIB=60
# One durable Turn document must stay below the 64 MiB storage frame. A
# tool-heavy Turn's toolRounds lane is compacted (oldest settled rounds'
# free-text payloads become honest stubs, replay identity intact) once its
# string payload crosses this budget; default 16 MiB leaves headroom for
# content/thinking and event metadata in the same frame.
# TOFU_TOOL_ROUNDS_FRAME_BUDGET_BYTES=16777216
# The sole SQLite writer receives an adaptive 8..64 MiB cache in personal
# mode (64 MiB on the 8 GiB reference host); explicit values are bounded at
# 8..256 MiB. Readers keep SQLite's lean default.
# TOFU_STORAGE_SQLITE_WRITER_CACHE_MIB=64
# The Sidecar may retain revision-exact live Turn write baselines to avoid
# repeatedly reading/decoding the same projection BLOB. Personal defaults are
# 16 MiB on probe failure, 32 MiB on the 8 GiB reference host, and at most
# 128 MiB adaptively; distributed defaults to 256 MiB. Explicit values are
# bounded to 8..1024 MiB, then charged at 3x stored bytes with a 256-entry and
# 10-minute-idle ceiling. Eviction safely falls back to durable storage.
# TOFU_STORAGE_TURN_PROJECTION_CACHE_MIB=32
# TOFU_STORAGE_RPC_CAPACITY=8
# Serialized frame bodies share a second, byte-weighted budget independently
# in the Sidecar and in every application/worker client process. Personal
# defaults scale 128..512 MiB from the same launch probe (128 MiB on the 8 GiB
# reference and probe-failure profiles); distributed defaults to 1024 MiB and
# explicit values are bounded 128..8192 MiB.
# TOFU_STORAGE_RPC_INFLIGHT_MAX_MIB=128
# After the last active RPC exits, personal Sidecars above their adaptive
# 128..384 MiB RSS threshold may return free glibc arenas once per minute;
# distributed mode defaults to five minutes. Explicit threshold/cooldown values
# remain bounded to 64..16384 MiB and 30..3600 seconds.
# TOFU_STORAGE_IDLE_TRIM_RSS_MIB=384
# TOFU_STORAGE_IDLE_TRIM_COOLDOWN_SECONDS=60
# Startup also reserves 1% of the filesystem containing `data/`, clamped to
# 256 MiB..2 GiB. The Sidecar refuses to start below that floor instead of
# consuming the last usable bytes for SQLite/WAL. An explicit byte value wins.
# TOFU_STORAGE_MIN_FREE_BYTES=2147483648
# Outbound webhooks reuse the launch-probed recent-client budget. On the
# personal fallback/reference profile they retain at most 64 subscriptions,
# 128 immediate deliveries + 64 delayed retries, and 16 MiB across both
# buffers. A single event is capped at 512 KiB before queueing; five actual
# attempts preserve the historical retry contract. Distributed defaults are
# 2048/2048/1024, 256 MiB, and 1 MiB/event. Explicit values remain bounded.
# TOFU_WEBHOOK_SUBSCRIPTION_CAPACITY=64
# TOFU_WEBHOOK_QUEUE_CAPACITY=128
# TOFU_WEBHOOK_BUFFER_MAX_MIB=16
# TOFU_WEBHOOK_EVENT_MAX_KIB=512
# TOFU_WEBHOOK_MAX_ATTEMPTS=5
# The unified Push WebSocket has independent process, owner, item, byte, and
# single-frame ceilings derived from the same launch probe. On the 8-GiB
# reference profile: 64 local clients, 12/owner, 1,000 queued events, 4 MiB
# retained/client and 2 MiB/event. Distributed defaults: 256, 64, 1,000,
# 16 MiB and 8 MiB. Slow clients reconcile from durable state after overflow.
# TOFU_PUSH_CLIENT_CAPACITY=64
# TOFU_PUSH_OWNER_CLIENT_CAPACITY=12
# TOFU_PUSH_EVENT_QUEUE_CAPACITY=1000
# TOFU_PUSH_EVENT_QUEUE_MAX_MIB=4
# TOFU_PUSH_EVENT_MAX_MIB=2
# Repeated Python run-command workloads may use their owner/workspace-scoped
# local cache; `auto` waits for a repeat-heavy workload before seeding it.
# TOFU_RUN_PYTHON_CACHE=auto
# TOFU_RUN_PYTHON_CACHE_MAX_MIB=64
# Tool Search caches tokenization only for inputs up to 1,024 characters.
# Personal capacity is launch-probed (512..4,096 entries; 1,024 on the 8 GiB
# reference host); longer descriptions stay fully searchable but never become
# resident LRU keys. Explicit capacity is hard-capped at 16,384.
# TOFU_TOOL_SEARCH_TERM_CACHE_CAPACITY=1024
# Reusable and streaming-prefetched tool receipts share one task-local FIFO.
# The 8 GiB reference keeps 128 entries (probe failure 64; distributed 512);
# explicit overrides are hard-capped at 1,024. Terminal settlement drops it.
# TOFU_TOOL_RESULT_CACHE_CAPACITY=128
# Memory summary lists cache parsed frontmatter only. The launch probe selects
# both entry and estimated-resident-byte ceilings (2,048 / 16 MiB on the 8 GiB
# reference host); explicit values are capped at 16,384 / 128 MiB.
# TOFU_MEMORY_METADATA_CACHE_CAPACITY=2048
# TOFU_MEMORY_METADATA_CACHE_MAX_MIB=16
# Managed server workers separately accelerate network/userspace checkouts.
# The default private host-temp namespace is keyed by project and interpreter;
# explicit Python bytecode policy wins. The size override is capped at 512 MiB.
# TOFU_SERVER_PYTHON_CACHE=auto
# TOFU_SERVER_PYTHON_CACHE_MAX_MIB=64
# TOFU_SERVER_PYTHON_CACHE_DIR=/fast-local-volume/tofu-server-pycache
# TOFU_STORAGE_PG_READ_POOL=32
# TOFU_STORAGE_PG_WRITE_POOL=16

# Writer deadlines preserve data durability: a stalled SQL phase is first
# interrupted 15 seconds past its transaction deadline; commit/fsync cannot be
# interrupted, so a sidecar still stuck 60 seconds past deadline exits and is
# recovered by its supervisor. HARD_KILL must be greater than STALL_GRACE.
# TOFU_STORAGE_TRANSACTION_TIMEOUT_S=5
# TOFU_STORAGE_WRITER_STALL_GRACE_S=15
# TOFU_STORAGE_WRITER_HARD_KILL_S=60

# Optional measured persistent-local SQLite write front. Keep this off until
# the bounded RPO in docs/TRB-fastpath.md is accepted. Auto mode never creates
# or restores an absent implicit /tmp front; choose an explicit directory whose
# lifecycle survives container/Pod replacement. For an existing large authority,
# compact offline first: first activation needs local free space for the full
# current database + WAL + a 1..8 GiB reserve and refuses before copying if the
# capacity is insufficient.
# TOFU_STORAGE_FASTPATH=off
# TOFU_STORAGE_FASTPATH_DIR=/var/lib/tofu-fastpath
# TOFU_STORAGE_FASTPATH_MIN_SPEEDUP=3.0
# TOFU_STORAGE_FASTPATH_STARTUP_TIMEOUT_S=900
# A rebase copies the full database. Its effective WAL trigger is one quarter
# of the authority size (at least 64 MiB), capped by 2% of launch-time free
# disk and 16 GiB. The two-WAL trigger envelope therefore uses at most 4% of
# observed free space; shipper start also rechecks the local-front and durable-
# shadow volumes and uses the smaller ceiling. Once a physical commit reaches
# this watermark, later writes fail before BEGIN with retryable database_busy
# until the shipper's raw checkpoint creates headroom; one already-started
# commit segment remains atomic. The image-plus-tail publication capacity check
# stays separate. This explicit value replaces only the adaptive ceiling and
# cannot bypass either filesystem check or the admission fence.
# TOFU_STORAGE_FASTPATH_WAL_REBASE_MAX_MIB=4096

# Optional transactional logical recovery stream. `off` preserves the current
# database-only path; `auto` activates only when topology policy has enough
# evidence; `required` refuses startup or readiness when durable publishing
# cannot be guaranteed. See docs/STORAGE.md before enabling it on an existing
# authority, and back up TOFU_SECRET_ENCRYPTION_KEY with the database.
# TOFU_STORAGE_LOGICAL_SHADOW=off
# TOFU_STORAGE_LOGICAL_SHADOW_DIR=/var/lib/tofu-logical-commits
# TOFU_STORAGE_LOGICAL_ACCESS=owner
# TOFU_STORAGE_LOGICAL_OUTBOX_MAX_MIB=128
# TOFU_STORAGE_LOGICAL_SHADOW_MAX_MIB=512
# TOFU_STORAGE_LOGICAL_SEGMENT_MIB=64
# TOFU_STORAGE_LOGICAL_RECORD_MAX_MIB=4
# TOFU_STORAGE_LOGICAL_PUBLISH_BATCH=32

# SQLite tuning defaults were measured on the project FUSE mount. Leave them
# unset unless operating evidence says otherwise.
# TOFU_SQLITE_BUSY_TIMEOUT_MS=30000
# TOFU_SQLITE_POOL_MAX=20
# TOFU_SQLITE_WAL_AUTOCHECKPOINT_PAGES=4096
# TOFU_SQLITE_SNAPSHOT_RETENTION=2
# Verified snapshots remain below project data/backups. Copying a verified
# artifact elsewhere is an operator export step, never a live storage path.
# TOFU_SQLITE_SNAPSHOT_MAX_AGE_HOURS=26
# Full-backup runtime derives from the launch-probed recovery-copy budget: a
# 30-minute floor, up to six hours by default, with a 24-hour override ceiling.
# Fastpath image copies preserve a source-fingerprinted fsync checkpoint every
# 256 MiB, so a timeout/restart resumes instead of rereading the whole database.
# TOFU_STORAGE_SQLITE_BACKUP_TIMEOUT_SECONDS=21600
# Fresh SQLite databases opt into incremental free-page reclamation. The
# maintenance daemon returns at most 256 pages (~1 MiB) every 15 minutes, and
# only after the freelist reaches 4096 pages (~16 MiB). Existing databases in
# auto_vacuum=NONE mode are never rewritten or converted automatically.
# Set pages to 0 to disable reclamation; raise only on fast local storage.
# TOFU_SQLITE_INCREMENTAL_VACUUM_PAGES=256
# TOFU_SQLITE_INCREMENTAL_VACUUM_MIN_FREE_PAGES=4096
# TOFU_SQLITE_INCREMENTAL_VACUUM_BUDGET_MS=250

# ── Sidecar authority: v2 transport retention + online page reclaim ──
# Task-event streaming and structural tiers expire after six hours and 30 days.
# Typed deletion stays at 25 rows per transaction. Authorities created before
# event type metadata can classify up to 100 small blank rows in that same
# transaction, but materialization and decoded payloads remain capped at 4 MiB.
# A live backlog gets at most 16 commits per pass and is revisited in 30 seconds;
# a drained tier returns to its five-minute probe cadence.
# TOFU_EVENT_PRUNE_BATCH_ROWS=25
# TOFU_EVENT_LEGACY_RECOVERY_ROWS=100
# TOFU_EVENT_PRUNE_BATCHES=16
# TOFU_TASK_EVENT_PRUNE_INTERVAL=300
# TOFU_STORAGE_BACKLOG_MAINTENANCE_INTERVAL=30
# storage_attempt_events is the SSE transport; turn rows are the permanent
# authority. Settled attempts older than this horizon lose their event
# stream (2026-08-20: full-projection frames grew the table to 281 GiB —
# 71% of the authority — before slim frames + this retention existed).
# TOFU_ATTEMPT_EVENT_TTL_DAYS=1
# Rolling prune cadence and per-transaction bounds. The row bound is sized
# so one transaction stays inside the writer watchdog even when surviving
# historical rows are ~600 KiB each (256 rows ≈ ≤150 MiB of WAL).
# TOFU_ATTEMPT_EVENT_PRUNE_INTERVAL=300
# TOFU_ATTEMPT_EVENT_PRUNE_MAX_ROWS=256
# TOFU_ATTEMPT_EVENT_PRUNE_MAX_ATTEMPTS=16
# Online incremental-vacuum slices for the sidecar authority (the legacy
# knobs above only ever reached the legacy daemon). 8192 pages = 32 MiB per
# cycle at most, checking the wall budget between one-page moves. A freelist
# above both 1,048,576 pages and 25% of the file is classified as an offline
# compaction instead of repeatedly probing it on the writer lane. Set pages to
# 0 to disable steady-state reclamation.
# TOFU_STORAGE_RECLAIM_INTERVAL=300
# TOFU_STORAGE_RECLAIM_PAGES=8192
# TOFU_STORAGE_RECLAIM_MIN_FREE_PAGES=1024
# TOFU_STORAGE_RECLAIM_BUDGET_MS=250

# Normalized conversation-message rows are enabled by default for the personal
# server. Every read still fails closed per conversation unless revision,
# exact row count, and lightweight projection count all match the authoritative
# parent row. These are emergency/migration kill switches, not install steps:
# TOFU_MESSAGES_ROWS=0
# TOFU_MESSAGES_ROWS_READ=0
# After a byte-for-byte production parity audit, this makes normalized rows the
# sole transcript authority. The legacy conversations.messages value freezes;
# startup refuses incomplete rows and runtime SQL rejects archive reads.
# TOFU_MESSAGES_ROWS_AUTHORITY=1
# Upgraded row stores fill the new fixed-width activity timestamp in a delayed,
# single-threaded online pass (10s initial delay, 100ms between conversations).
# New installs have nothing to backfill. Optional slow-disk controls:
# TOFU_MESSAGES_ACTIVITY_BACKFILL=0
# TOFU_MESSAGES_ACTIVITY_BACKFILL_INITIAL_MS=10000
# TOFU_MESSAGES_ACTIVITY_BACKFILL_SLEEP_MS=100

# Online retention is intentionally conservative on FUSE-backed personal
# installs: task_results may each own MiB-sized TOAST values, so only 25 rows
# are deleted per transaction (at most 4 transactions per maintenance cycle).
# Raise these only after measuring the storage underneath PostgreSQL.
# TOFU_TASK_RESULT_PRUNE_BATCH_ROWS=25
# TOFU_TASK_RESULT_PRUNE_BATCHES=4

# ── Data / state location (keep user data OUT of the code tree) ──
# All mutable user/runtime state — the database, config, logs, uploads,
# global memories — lives under ONE writable "data root". Keeping it
# separate from the code tree means an in-place update (git pull, or the
# tarball-overlay updater for non-git installs) only ever touches source,
# never races your open database.
#
# Resolution precedence: TOFU_DATA_DIR > TOFU_DATA_LAYOUT > auto-detect.
#
# TOFU_DATA_DIR — absolute override. Point it anywhere writable and the
# DB, logs, config and memories all follow. Highest precedence.
# TOFU_DATA_DIR=/var/lib/tofu/data
#
# TOFU_DATA_LAYOUT — for a plain source/git checkout, choose where state
# lands when TOFU_DATA_DIR is unset:
#   auto   (default) — an existing populated in-tree ./data keeps working
#                      in-place (zero migration); a FRESH clone with no
#                      ./data defaults OUT of the tree to a per-user dir
#                      (~/.local/share/Tofu, %LOCALAPPDATA%\Tofu, or
#                      ~/Library/Application Support/Tofu).
#   intree           — force the legacy ./data-inside-the-repo layout.
#   xdg              — force the per-user dir even if ./data exists
#                      (opt-in relocation for an existing install).
# TOFU_DATA_LAYOUT=auto


# ── Open-mode per-IP throttle ─────────────────────
# In `open` auth mode (the default), requests get a synthetic local-admin
# context, and a per-IP requests-per-minute cap guards the EXPENSIVE
# surfaces (chat / agent / search / generate) against strangers hammering
# an exposed instance. The cap is scoped to the one configuration where
# unauthenticated strangers can actually arrive:
#
#   • Default (loopback-only personal install): cap OFF. The only IPs
#     that could ever hit it are your own tabs and background polls —
#     throttling them would just throttle you.
#   • TOFU_OPEN_MODE_ALLOW_REMOTE=1 (remote open-mode peers admitted):
#     cap auto-arms at 120 req/min per IP. Ambient UI reads (task polls,
#     browser/desktop status, model health) never count against it.
#   • TOFU_OPEN_MODE_RPM=<n> always wins, both directions: n>0 arms the
#     cap even on a loopback-only box; 0 disarms it even with remote
#     peers admitted.
#
# Behind a same-host proxy/tunnel the cap cannot tell you from a stranger
# (everything arrives as 127.0.0.1). Use `private` mode for those deployments;
# IP throttling is not authentication. Extend the exempt read paths via
# TOFU_OPEN_MODE_EXEMPT_PATHS (comma-separated path substrings).

# TOFU_OPEN_MODE_ALLOW_REMOTE=0
# TOFU_OPEN_MODE_RPM=
# TOFU_OPEN_MODE_EXEMPT_PATHS=


# ── Client IP / reverse-proxy semantics (read this if you use a proxy) ──
# Tofu ALWAYS uses the directly-connected peer address as the client IP.
# `X-Forwarded-For` and `X-Forwarded-Proto` are NEVER trusted — there is
# no trusted-proxy option, by design (a spoofable header must not be able
# to move an IP-keyed security decision).
#
# The peer address keys three real decisions, so know what it will be:
#   - per-IP rate-limit buckets
#   - the open-mode "local admin" grant (loopback peers only)
#   - audit-log entries
#
# ⚠️  CONSEQUENCE FOR REVERSE-PROXY / TUNNEL DEPLOYMENTS
# If nginx / Caddy / ngrok / cloudflared runs on the SAME host and proxies
# to 127.0.0.1, then EVERY request — including ones from the public
# internet — arrives with the peer address 127.0.0.1. That means:
#   - all clients share ONE open-mode throttle bucket (armed only when
#     TOFU_OPEN_MODE_RPM / TOFU_OPEN_MODE_ALLOW_REMOTE is set — see the
#     throttle section above);
#   - audit logs record 127.0.0.1 instead of the real caller;
#   - in `open` auth mode the loopback admin grant would apply to public
#     traffic, so DO NOT run open mode behind a same-host proxy. Use
#     `private` mode (a real credential) — see the auth section below.
#
# To keep real client IPs meaningful, terminate the proxy on a DIFFERENT
# host, or have the proxy enforce authentication itself.
#
# Historical note: a `TOFU_TRUST_PROXY_HOPS` setting was documented here
# but never implemented — the server is ASGI (Quart/Hypercorn) and the
# Werkzeug `ProxyFix` middleware it referred to is WSGI-only, so it could
# not have taken effect. Setting it did nothing. It has been removed
# rather than left as a promise the code does not keep.
# Guard: tests/test_proxy_trust.py asserts both the observed behaviour and
# that this file does not re-introduce an unimplemented promise.


# ── Image-fetch SSRF guard ────────────────────────────────────
# /api/images/generate accepts user-supplied image_url values for
# multi-turn editing. By default the server blocks any URL whose host
# resolves to loopback / RFC1918 / link-local / multicast / reserved
# IPs, and caps response bodies at 10 MB. Override only if you self-host
# image storage on a private endpoint that you trust.

# TOFU_IMAGE_FETCH_ALLOW_HOSTS=internal-images.example.com,storage.local
# TOFU_IMAGE_FETCH_MAX_BYTES=10485760



# ── Rate-limit counter backend ────────────────────────────────
# Where the @rate_limit decorator stores its per-(endpoint, ip) counters:
#   memory  (default) — in-process dict; correct for single-process Flask
#   db      — INSERT into rate_limit_events table; survives restarts and
#             works across multi-worker WSGI (gunicorn / uWSGI N>1)
#
# If you run gunicorn or uWSGI with worker count > 1, you MUST set this
# to `db` — otherwise each worker has its own counter and the effective
# limit is N × the configured value.  Single-process `python server.py`
# users can keep the default.

# TOFU_RATE_LIMIT_BACKEND=memory
# Maximum process-local endpoint/client buckets. The exact timestamp envelope
# is derived at 128 events per bucket and capped globally; ignored by `db`.
# TOFU_RATE_LIMIT_MEMORY_BUCKET_CAPACITY=


# ── Proxy (if behind a corporate firewall) ────────────────────

# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# PROXY_BYPASS_DOMAINS=.internal.example.com,.corp.example.com


# ── Feishu / Lark Bot (optional) ──────────────────────────────
# Create an app at https://open.feishu.cn/app with Bot capability.

# FEISHU_APP_ID=cli_xxx
# FEISHU_APP_SECRET=xxx
# Map Feishu open_id values to application owner ids. This keeps external
# identities explicit and ready for multi-user deployments.
# FEISHU_USER_OWNER_MAP={"ou_xxx":1,"ou_yyy":2}
# For an intentionally single-owner bot deployment, configure that owner
# explicitly instead of relying on an implicit user 1.
# FEISHU_DEFAULT_OWNER_USER_ID=1


# ── Feature Flags ─────────────────────────────────────────────

# Enable trading advisor module (default: 0 = off)
# TRADING_ENABLED=0

# Enable debug mode (default: 0 = off)
# DEBUG_MODE=0


# ── Search & Fetch ────────────────────────────────────────────
# These can also be configured in Settings UI (⚙️ → Search & Fetch).

# Number of search results to auto-fetch (default: 6)
# FETCH_TOP_N=6

# Per-page fetch timeout in seconds (default: 15)
# FETCH_TIMEOUT=15

# Max characters per page for search results (default: 60000)
# FETCH_MAX_CHARS_SEARCH=60000

# Max characters per page for direct URL fetch (default: 200000)
# FETCH_MAX_CHARS_DIRECT=200000

# Depth: follow the top query-relevant outbound links one hop deeper after
# the main fetch (0 = off, default; 1 = one hop). Adds ~1-3s. Can also be
# toggled per-call via perform_web_search(deepen=True) or features.json
# (search_deepen). Increases coverage at the cost of some latency.
# SEARCH_DEEPEN_HOPS=0

# Hard wall-clock deadline (seconds) for ONE web_search call (default: 45).
# When the budget expires the pipeline force-returns whatever pages it has
# gathered so far (tagged as a partial result) instead of blocking on slow or
# unreachable hosts — it caps the fetch-wait loop and short-circuits the
# LLM-filter / deepen / rerank stages. This is the guard against a niche-domain
# query (mostly dead/paywalled hosts) wedging the turn: the only prior caps
# were a 20s engine timeout and a 90s fetch timeout that only exits early once
# enough pages succeed, which such a query never reaches. Set 0 to disable
# (legacy unbounded behaviour). Look for `⏱ DEADLINE` lines in logs/app.log.
# TOFU_SEARCH_DEADLINE_SECS=45

# Per-URL total-time cap (seconds) bounding the WHOLE fallback chain for one
# page (HTTP body-download + browser fallback + Playwright render), so a single
# dead host can't stack per-hop timeouts into 60s+ (default: 25). Soft bound:
# once blown, remaining fallback hops are skipped rather than killed mid-flight,
# so worst case ≈ deadline + one in-flight hop. Set 0 to disable.
# TOFU_SEARCH_FETCH_URL_DEADLINE_SECS=25

# Maximum formatted log records buffered while the log filesystem is slow
# (default 20000, clamped to 1000..500000). Producers never block; overload is
# shed and summarized after recovery instead of growing memory without bound.
# Normal single-user installations should keep the default.
# TOFU_LOG_QUEUE_MAX=20000
# Total direct logs/ retention adapts to project-volume free space: 64 MiB
# below 4 GiB free, 128 MiB below 16 GiB, otherwise 256 MiB. Distributed mode
# remains 512 MiB. Per-stream rotation still protects high-value evidence.
# TOFU_LOG_TOTAL_BUDGET_MB=256

# Audit trail size rotation (defaults: 64 MiB per file, 4 backups). This keeps
# security/audit diagnostics while preventing the manually appended JSONL file
# from growing forever. Values are optional for normal single-user installs.
# TOFU_AUDIT_LOG_MAX_BYTES=67108864
# TOFU_AUDIT_LOG_BACKUPS=4
# Maximum queued audit records while the log filesystem is stalled (default
# 4096, clamped to 128..100000). Producers never block; overload discards the
# oldest queued record so memory stays bounded and recent evidence is kept.
# TOFU_AUDIT_LOG_QUEUE_MAX=4096

# Crash/stall dump bounds (16 MiB active file; newest 8 dead-process files
# within 64 MiB total). Raw SSE anomaly blocks rotate at 32 MiB × 3 files.
# These diagnostics stay enabled; the limits only prevent runaway disk use.
# TOFU_FAULT_DUMP_MAX_BYTES=16777216
# TOFU_FAULT_DUMP_FILES=8
# TOFU_FAULT_DUMP_TOTAL_BYTES=67108864
# TOFU_RAW_SSE_ANOMALY_MAX_BYTES=33554432
# TOFU_RAW_SSE_ANOMALY_BACKUPS=2

# Interrupted chat turns are always checkpointed and surfaced for manual
# Continue after a restart/crash. Automatically starting a replacement LLM
# request at boot is OFF by default because it is a new billed operation.
# Enable only when unattended recovery is desired. Ordinary chat turns from a
# clean/manual stop remain manual; unclean killed turns may be re-dispatched,
# and an explicitly armed Autopilot run may resume through the same gate.
# Killed-turn recovery is attempt-capped and concurrency-bounded to avoid an
# OOM/restart storm re-firing a large batch of turns at once.
# TOFU_BOOT_AUTO_DISPATCH=0
# TOFU_KILLED_RECOVERY_MAX_ATTEMPTS=3
# TOFU_KILLED_RECOVERY_MAX_CONCURRENT=2
# TOFU_KILLED_RECOVERY_INLINE_BOOT=1
# TOFU_KILLED_RECOVERY_DRAIN_POLL_SECS=15
# TOFU_RESTART_STORM_THRESHOLD=5
# TOFU_RESTART_STORM_WINDOW_SECS=120

# The external lifecycle manager applies the same rolling crash-loop budget to
# worker deaths, including workers that briefly became healthy between OOMs.
# Failures back off exponentially; the fifth within two minutes pauses recovery
# until an explicit start/restart, preventing a resource-amplifying storm.
# TOFU_MANAGER_MAX_FAILURES=5
# TOFU_MANAGER_FAILURE_WINDOW_SECS=120

# Agent/task backpressure. Personal mode derives 1..48 resident Agent slots
# from effective CPU, memory capacity, launch-time available headroom, and the
# worker hard-RSS budget minus its process baseline. The 8-GiB reference stays
# at 4 slots; a 64-CPU/64-GiB server with 48 GiB available resolves to 18,
# while a very large host can use all 48 slots inside the 64-GiB worker cap.
# The per-task live-state envelope is 512 MiB on smaller workers and 1 GiB once
# the worker hard ceiling exceeds 3 GiB. Raising TOFU_MAX_INFLIGHT_TASKS alone
# cannot bypass that safety bound; raise the RSS budget only after measurement.
# Independently, new tasks are refused when one more task envelope no longer
# fits below this worker's hard RSS ceiling or the shared cgroup is >=96% full.
# Set the individual gate to 0 only for diagnosed deployments. These do not
# change the normal `python server.py` launch command.
# TOFU_MAX_INFLIGHT_TASKS=4
# TOFU_TASK_RSS_RESERVE_MB=512
# TOFU_ADMISSION_PROCESS_RSS=1
# TOFU_ADMISSION_CGROUP_PCT=96
# TOFU_AGENT_WORKERS=4
# Reconstructible TaskRuntime retention reuses the same launch probe. The
# probe-failure / 8-GiB reference / distributed profiles retain at most
# 64/128/512 terminal records per task kind, 1,024/2,048/4,096 events per
# task, 2/4/8 MiB ordinary replay tails, and one 4/8/16 MiB event. A valid
# event above the ordinary tail target occupies the window alone; a larger or
# unencodable event resets only process-memory replay while durable/live seams
# keep their existing authority. Hard caps are 1,024 / 8,192 / 16 / 16.
# Explicit TaskRuntime constructor values may lower, never widen, these limits.
# TOFU_TASK_RUNTIME_TASK_CAPACITY=128
# TOFU_TASK_RUNTIME_EVENT_CAPACITY=2048
# TOFU_TASK_RUNTIME_REPLAY_MAX_MIB=4
# TOFU_TASK_RUNTIME_EVENT_MAX_MIB=8
# Hot terminal chat tasks remain directly pollable for 600 seconds on the
# 8-GiB/personal fallback profile, then owner-scoped task-results + event cold
# replay serve detail/events/SSE. Personal auto range 600..1800; distributed
# default 3600; explicit values are clamped to 60..86400 seconds.
# TOFU_CHAT_TASK_TERMINAL_TTL_SECONDS=600
# Read-only tool concurrency; streaming prefetch reuses at most four workers
# and keeps no more than eight speculative calls in one model round. Provider
# capability probes reuse at most eight aggregate calls in a finite fair lane.
# TOOL_MAX_PARALLEL_WORKERS=4
# Finite pre-worker FIFO: auto = workers*8 (8..512), hard ceiling 4096.
# TOFU_AGENT_QUEUE_CAPACITY=32
# Bounded replacement residency for reaper-proven stuck Python calls.
# Auto = ceil(workers/4), 1..4; explicit hard ceiling min(16, workers).
# TOFU_AGENT_STUCK_REPLACEMENTS=1
# TOFU_SYNC_WORKERS=8

# Independent LLM calls inside one long-production stage (research judges,
# long-form sections) share this per-job fan-out. Personal mode derives 1..2
# from the launch probe (8-GiB reference: 2; probe failure: 1), distributed
# defaults to 4, and every explicit override is capped at 8.
# TOFU_PRODUCTION_LLM_FANOUT=2

# Actual upstream 429 responses per model call in background production work.
# Personal mode derives 4..8 (probe failure: 4), distributed defaults to 16,
# and overrides are capped at 64. Interactive chat keeps its separate policy.
# TOFU_PRODUCTION_LLM_MAX_429_ATTEMPTS=8

# Independent background image calls retain encoded and decoded image bytes.
# Personal mode derives 1..2 fan-out (probe failure: 1), distributed defaults
# to 4, and overrides are capped at 4.
# TOFU_PRODUCTION_IMAGE_FANOUT=2

# Actual upstream 429 responses per background image-generation call.
# Personal mode derives 4..8 (probe failure: 4), distributed defaults to 16,
# and overrides are capped at 64. Interactive generation keeps its 120-cycle
# compatibility safety cap unless a production caller supplies this policy.
# TOFU_PRODUCTION_IMAGE_MAX_429_ATTEMPTS=8

# Independent narration segments retain audio bytes until ordered assembly.
# Personal mode derives 1..2 (probe failure: 1), distributed defaults to 4,
# and overrides are capped at 8.
# TOFU_PRODUCTION_TTS_FANOUT=2

# All SSE endpoints share one launch-probed per-principal socket/lease budget.
# The 8-GiB reference profile resolves to 12, smaller known machines to 8,
# distributed mode to 64, and every override remains hard-capped at 128.
# Zero/malformed values fall back instead of disabling this resident-resource
# boundary. Conversation streams also replace older generations from the same
# browser page so proxy disconnect loss cannot accumulate zombie upstreams.
# TOFU_MAX_SSE_PER_PRINCIPAL=12
# TOFU_SSE_SLOT_TTL=300  # refreshed while live; clamped to 45..3600 seconds

# Project tree-index scans share one process-wide metadata pool across every
# concurrently warming root. The 8-GiB reference profile uses 8 scan workers,
# a 409,600-path global retention ceiling, and at most 2 resident roots; lower
# memory probes scale down and dedicated distributed workers retain explicit
# hard ceilings. Overrides cannot create unbounded pools or caches.
# TOFU_TREE_INDEX_WALK_JOBS=8
# TOFU_TREE_INDEX_MAX_ENTRIES=409600
# TOFU_TREE_INDEX_MEM_ROOTS=2

# Process-local OOM prevention. At the soft RSS ceiling Tofu clears bounded
# caches, drops its log page cache and asks glibc to return free arenas. If RSS
# remains above the hard ceiling afterward, it performs one graceful worker
# recycle; the lifecycle manager/container restart policy restores a fresh
# process. The stdlib lifecycle manager independently samples /proc and enforces
# the same hard ceiling, so it also protects an older worker before that worker
# has loaded the newest in-process guard. Set either value to 0 only to disable
# that layer. Keep the hard ceiling comfortably below the deployment's memory
# limit and above legitimate peak working-set measurements.
# Personal soft/hard ceilings derive from effective memory capacity and current
# headroom. A normal 8-GiB desktop resolves to 2048/3072 MiB; a dedicated 4-GiB
# cgroup can use up to roughly 50%/70%. Floors prevent a transient low-headroom
# sample from creating a recycle loop. Distributed defaults remain 4096/8192.
# TOFU_PROCESS_RSS_RELIEF_MB=2048
# TOFU_PROCESS_RSS_RECYCLE_MB=3072
# TOFU_PROCESS_RSS_COOLDOWN_SEC=300
# Repeated aggregate pressure relief below the material-reclaim floor cools down
# at this base delay, then probes at 2x intervals up to one hour while pressure
# journaling and per-process RSS limits remain active. Recovery resets the delay.
# TOFU_CGROUP_RELIEF_COOLDOWN_SEC=600
# glibc arena count follows the probed numeric budget (personal 1..4;
# distributed 8) and is installed before each source/desktop child starts.
# Container PID 1 cannot probe before glibc starts, so its safe fallback is 2.
# TOFU_MALLOC_ARENA_MAX=2

# Implicit native numeric pools (OpenBLAS/OpenMP/MKL/NumExpr) adapt from 1..4
# threads. This prevents a high-core host from creating 64+ idle native threads
# alongside Tofu's own executors. Explicit library-specific variables still
# win, and this knob may be raised for dedicated CPU-heavy PDF/ML workloads.
# TOFU_NUMERIC_THREADS=2

# Codex subscription prompt-cache pacing. The private Responses endpoint does
# not report cache writes, so Tofu infers a pending write and holds the next
# cacheable tool-loop request for up to 5s. It also spaces starts by 4.2s to
# stay below OpenAI's approximate 15 requests/minute per prompt_cache_key
# boundary. These apply only to oauth_codex; other providers keep their own
# cache-settle policy. Lower values trade cache hits for tool-loop latency.
# TOFU_CACHE_SETTLE_CODEX_VISIBILITY_MS=5000
# TOFU_CACHE_SETTLE_CODEX_SEND_INTERVAL_MS=4200
# TOFU_CACHE_SETTLE_CODEX_MAX_MS=6000
# TOFU_CACHE_SETTLE_CODEX_THRESHOLD_TOKENS=1024
# TOFU_CACHE_SETTLE_CODEX_WARM_WRITE_TOKENS=8192


# ── PDF Parsing ───────────────────────────────────────────────

# Classic local PDF parsing shares one aggregate admission budget across direct
# calls and the process pool. The 8 GiB reference profile uses 1 child / 3
# unfinished PDFs / 512 pages / 4 MiB text / 1,024 s and retires children after
# 60 idle seconds. Probe-failure fallback is 1 / 3 / 256 / 2 MiB / 300 s / 60 s
# idle; distributed mode is 4 / 16 / 2,048 / 16 MiB / 3,600 s / 600 s idle.
# Explicit overrides remain inside hard ceilings of 16 / 64 / 4,096 / 64 MiB /
# 3,600 s / 86,400 s idle. A timed-out running parse keeps its slot until the
# child really settles; it is never duplicated in the server process. Request
# values may lower page/text limits; images stop at 64 and 2,048 px. Idle `0`
# keeps the process pool resident for dedicated parsing hosts.
# TOFU_PDF_PROCESSES=1
# TOFU_PDF_PARSE_CAPACITY=3
# TOFU_PDF_MAX_PAGES=512
# TOFU_PDF_MAX_TEXT_MIB=4
# TOFU_PDF_PARSE_TIMEOUT=1024
# TOFU_PDF_WORKER_IDLE_SECONDS=60

# Default text-extract strategy for /api/pdf/parse:
#   rich        — pymupdf4llm (default; ships out of the box)
#   structured  — IBM Docling (better tables + math on academic PDFs).
#                 Requires `pip install docling` (~2 GB; pulls torch).
#                 If docling is missing or fails, server falls back to
#                 rich automatically — uploads never break.
#   fast        — raw pymupdf get_text (no Markdown structure, ~50× faster)
# PDF_TEXT_MODE=rich

# VLM PDF parser tuning (applies when VLM mode is used).
# Pages per single VLM call (1–16). Default 4. Larger = fewer HTTP
# round-trips and less 429 thrash, but more output tokens per call.
# PDF_VLM_BATCH_PAGES=4

# Legacy cap on concurrent VLM calls. It may only lower the launch-derived
# TOFU_PDF_VLM_CALL_WORKERS budget; it never creates an unlimited thread pool.
# PDF_VLM_MAX_WORKERS=8

# Output token cap per VLM call. Default scales with batch (4096/page).
# PDF_VLM_MAX_TOKENS=16384

# Local Knowledge PDF ingestion keeps validation, text, OCR, visual extraction,
# asset/source persistence, and the repository commit inside one classic-PDF
# admission lease. OCR/visual page
# overrides may lower but cannot exceed TOFU_PDF_MAX_PAGES. Defaults retain 80
# OCR pages, 80 visual pages, 160 assets / 160 MiB per document, 25 MiB per
# asset, and 40 million decoded pixels per image. Hard ceilings are 500 pages,
# 1,000 assets / 1 GiB, 100 MiB/asset, and 100 million pixels. OCR also stops
# immediately at the bounded knowledge text budget rather than scanning pages
# whose text would be discarded.
# TOFU_KNOWLEDGE_MAX_TEXT_CHARS=12000000
# TOFU_KNOWLEDGE_OCR_MAX_PAGES=80
# TOFU_KNOWLEDGE_VISUAL_MAX_PAGES=80
# TOFU_KNOWLEDGE_MAX_VISUAL_ASSETS=160
# TOFU_KNOWLEDGE_MAX_VISUAL_BYTES=167772160
# TOFU_KNOWLEDGE_MAX_ASSET_BYTES=26214400
# TOFU_KNOWLEDGE_MAX_IMAGE_PIXELS=40000000
