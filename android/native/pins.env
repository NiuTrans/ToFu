# Pinned inputs of build-proot.sh. Bump a version together with its URL,
# SHA-256, the matching file under licenses/ and README.md.

# Android NDK r27d, installed side by side as $ANDROID_HOME/ndk/$NDK_VERSION
# (sdkmanager "ndk;27.3.13750724").
NDK_VERSION=27.3.13750724

# termux/proot tag v5.1.107.102 = commit 52d65a4dc140ca554d241a1438ddd4f6b00c9813.
# The same archive and SHA-256 are pinned by termux/termux-packages
# packages/proot/build.sh.
PROOT_VERSION=5.1.107.102
PROOT_COMMIT=52d65a4dc140ca554d241a1438ddd4f6b00c9813
PROOT_URL=https://github.com/termux/proot/archive/v5.1.107.102.zip
PROOT_SHA256=30d12a6e2cc4147123756ff58edea262d3083bbc238c12d0ab9b39e3d1c40852
# Compiled-in loader directory, used only when PROOT_LOADER is unset. It does
# not exist on Android, so a launch without PROOT_LOADER fails every guest
# execve with ENOENT instead of running some other loader.
PROOT_UNBUNDLE_LOADER=/PROOT_LOADER-unset

# Official Samba release; also pinned by termux/termux-packages
# packages/libtalloc/build.sh. Signed by the Samba Library Distribution Key
# 9147A339719518EE9011BCB54793916113084025 (talloc-2.5.0.tar.asc).
TALLOC_VERSION=2.5.0
TALLOC_URL=https://www.samba.org/ftp/talloc/talloc-2.5.0.tar.gz
TALLOC_SHA256=912afa237510ae542a7733998eb18a12bcda35ab6729c8e2ddb43e8d0ebab007

# licenses/GPL-3.0.txt, the GNU GPL that LGPL-3.0 section 4(b) requires next to
# talloc's licence. licenses/proot-COPYING and licenses/talloc-LICENSE are
# compared with the pinned archives by build-proot.sh instead.
GPL3_URL=https://www.gnu.org/licenses/gpl-3.0.txt
GPL3_SHA256=3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986
