<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Voice input: the SPA calls getUserMedia() for speech recognition; the
         WebView forwards the mic request, which needs this permission granted. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- QR onboarding: the embedded ZXing CaptureActivity requests the camera
         at runtime; declaring it here makes the dependency explicit and is
         required for the scanner to run. Optional hardware so the app still
         installs on camera-less devices (scan is only one way to add a server). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- DownloadManager writing to public Downloads needs this only on API
         ≤28 (scoped storage covers 29+). -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:name=".TofuApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Tofu"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="33"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.TofuClient">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- `tofu://connect?url=<server>&name=<label>` — a link the server
                 (or an operator) can encode as a QR code or send directly, so a
                 phone adds a server without typing a long URL. `singleTop`
                 keeps one task and re-delivers via onNewIntent when the app is
                 already open. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tofu" android:host="connect" />
            </intent-filter>
        </activity>


        <!-- Camera-capture staging for the file-chooser chooser (WebScreen
             buildChooserWithCamera): photos land in cacheDir and are handed
             to the picker/camera app via a grant-scoped content uri. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
