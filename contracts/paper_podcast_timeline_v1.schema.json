{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paper_podcast_timeline_v1.schema.json",
  "title": "Measured podcast segment timeline",
  "description": "Optional meta.timelineV1 receipt. Times describe PCM segment boundaries, including actual injected pauses; they are not word alignment. Missing receipts do not authorize estimated seeking.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "basis", "durationSec", "segments"],
  "properties": {
    "format": {"const": "paper.podcast.timeline.v1"},
    "basis": {"const": "measured_pcm"},
    "durationSec": {"type": "number", "exclusiveMinimum": 0},
    "segments": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["index", "startSec", "endSec"],
        "properties": {
          "index": {"type": "integer", "minimum": 0, "maximum": 63},
          "startSec": {"type": "number", "minimum": 0},
          "endSec": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    }
  }
}
