{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tofu.automation-management/v1",
  "title": "Authenticated automation management",
  "x-limits": {
    "pageRows": 8,
    "requestBytes": 263168
  },
  "$defs": {
    "PublishRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        },
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "definition": {
          "$ref": "tofu.automation/v1"
        }
      },
      "required": [
        "expectedRevision",
        "requestId",
        "definition"
      ]
    },
    "RevisionRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        },
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        }
      },
      "required": [
        "expectedRevision",
        "requestId"
      ]
    },
    "CancelRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "requestId",
        "reason"
      ]
    },
    "Definition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,159}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "definition": {
          "$ref": "tofu.automation/v1"
        },
        "digest": {
          "type": "string"
        },
        "status": {
          "enum": [
            "draft",
            "published",
            "paused",
            "retired"
          ]
        },
        "updatedAt": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "id",
        "revision",
        "definition",
        "digest",
        "status",
        "updatedAt"
      ]
    },
    "Step": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string"
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "arguments": {},
        "output": {},
        "error": {},
        "startedAt": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "completedAt": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "approval": {
          "$ref": "#/$defs/Approval"
        }
      },
      "required": [
        "status",
        "attempts"
      ]
    },
    "Run": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,159}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "definitionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,159}$"
        },
        "definitionRevision": {
          "type": "integer",
          "minimum": 1
        },
        "definitionDigest": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "createdAt": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "updatedAt": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "deadlineAt": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "trigger": {
          "type": "object"
        },
        "steps": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Step"
          }
        },
        "completedAt": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cancelReason": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "revision",
        "definitionId",
        "definitionRevision",
        "definitionDigest",
        "status",
        "createdAt",
        "updatedAt",
        "deadlineAt",
        "trigger",
        "steps"
      ]
    },
    "Action": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "input": {
          "type": "object"
        },
        "output": {
          "type": "object"
        },
        "effect": {
          "type": "string"
        },
        "recovery": {
          "type": "string"
        },
        "requiredScopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "version",
        "input",
        "output",
        "effect",
        "recovery",
        "requiredScopes"
      ]
    },
    "DefinitionPage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/Definition"
          }
        },
        "nextCursor": {
          "type": "string",
          "maxLength": 256
        }
      },
      "required": [
        "items",
        "nextCursor"
      ]
    },
    "RunPage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/Run"
          }
        },
        "nextCursor": {
          "type": "string",
          "maxLength": 256
        }
      },
      "required": [
        "items",
        "nextCursor"
      ]
    },
    "ActionPage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Action"
          }
        }
      },
      "required": [
        "items"
      ]
    },
    "StartRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expectedRevision": {
          "type": "integer",
          "minimum": 1
        },
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        }
      },
      "required": [
        "expectedRevision",
        "requestId"
      ]
    },
    "ApproveRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expectedRevision": {
          "type": "integer",
          "minimum": 1
        },
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}(?![\\s\\S])"
        },
        "stepId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}(?![\\s\\S])"
        }
      },
      "required": [
        "expectedRevision",
        "requestId",
        "stepId"
      ]
    },
    "Approval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}(?![\\s\\S])"
        },
        "approvedAt": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "requestId",
        "approvedAt"
      ]
    },
    "Presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "runId",
        "stepId",
        "conversationId",
        "attemptId",
        "turnId",
        "output"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "runId": {
          "type": "string",
          "maxLength": 160
        },
        "stepId": {
          "type": "string",
          "maxLength": 64
        },
        "conversationId": {
          "type": "string",
          "maxLength": 256
        },
        "attemptId": {
          "type": "string",
          "maxLength": 128
        },
        "turnId": {
          "type": "string",
          "maxLength": 256
        },
        "output": {
          "$ref": "tofu.automation-action-output/task.show_time"
        }
      }
    },
    "PresentationPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "nextCursor"
      ],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/Presentation"
          }
        },
        "nextCursor": {
          "type": "string",
          "maxLength": 64
        }
      }
    },
    "ProjectUpdateRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "active": {
          "type": "boolean"
        }
      },
      "required": [
        "expectedRevision",
        "requestId",
        "root",
        "label",
        "active"
      ]
    },
    "Project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^project_[0-9a-f]{64}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "active": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "updatedAt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "revision",
        "root",
        "label",
        "active",
        "createdAt",
        "updatedAt"
      ]
    },
    "ProjectPage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/Project"
          }
        },
        "nextCursor": {
          "type": "string",
          "maxLength": 160
        }
      },
      "required": [
        "items",
        "nextCursor"
      ]
    },
    "SkillSourceUpdateRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "environment": {
          "type": "string",
          "enum": [
            "prod",
            "test",
            "dev"
          ]
        },
        "active": {
          "type": "boolean"
        },
        "credential": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192,
              "pattern": "^[!-~]+(?![\\s\\S])"
            }
          ]
        }
      },
      "required": [
        "expectedRevision",
        "requestId",
        "environment",
        "active"
      ]
    },
    "SkillSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "mtskills"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "environment": {
          "type": "string",
          "enum": [
            "prod",
            "test",
            "dev"
          ]
        },
        "active": {
          "type": "boolean"
        },
        "credentialConfigured": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "integer",
          "minimum": 1
        },
        "updatedAt": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "revision",
        "environment",
        "active",
        "credentialConfigured"
      ]
    }
  }
}
