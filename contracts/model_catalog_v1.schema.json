{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tofu.local/contracts/model_catalog_v1.schema.json",
  "title": "Tofu normalized model catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "revision",
    "models",
    "offerings",
    "routes"
  ],
  "properties": {
    "contract_version": {"const": "tofu.model-catalog/v1"},
    "revision": {"type": "integer", "minimum": 0},
    "models": {
      "type": "object",
      "maxProperties": 1024,
      "additionalProperties": {"$ref": "#/$defs/logicalModel"}
    },
    "offerings": {
      "type": "object",
      "maxProperties": 4096,
      "additionalProperties": {"$ref": "#/$defs/offering"}
    },
    "routes": {
      "type": "object",
      "maxProperties": 1024,
      "additionalProperties": {"$ref": "#/$defs/route"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f]+$"
    },
    "uniqueIdentifiers": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "logicalModel": {
      "type": "object",
      "required": ["model_id", "enabled", "capabilities"],
      "properties": {
        "model_id": {"$ref": "#/$defs/identifier"},
        "enabled": {"type": "boolean"},
        "capabilities": {"$ref": "#/$defs/uniqueIdentifiers"},
        "display_name": {"type": "string", "maxLength": 256},
        "brand": {"type": "string", "maxLength": 128},
        "thinking_default": {"type": "boolean"},
        "capability_profile": {"type": "object"},
        "provenance": {"type": "object"}
      },
      "additionalProperties": true
    },
    "pricing": {
      "type": "object",
      "required": ["input", "output", "currency", "unit"],
      "properties": {
        "input": {"type": "number", "minimum": 0},
        "output": {"type": "number", "minimum": 0},
        "currency": {"enum": ["USD", "CNY"]},
        "unit": {"const": "per_million_tokens"}
      },
      "additionalProperties": true
    },
    "configuration": {
      "type": "object",
      "required": ["rpm", "capabilities"],
      "properties": {
        "request_ids": {"$ref": "#/$defs/uniqueIdentifiers"},
        "aliases": {"$ref": "#/$defs/uniqueIdentifiers"},
        "rpm": {"type": "integer", "minimum": 1},
        "capabilities": {"$ref": "#/$defs/uniqueIdentifiers"},
        "context_window": {
          "oneOf": [
            {"type": "integer", "minimum": 1},
            {"type": "null"}
          ]
        },
        "pricing": {
          "oneOf": [
            {"$ref": "#/$defs/pricing"},
            {"type": "null"}
          ]
        },
        "brand": {"type": "string", "maxLength": 128},
        "display_name": {"type": "string", "maxLength": 256},
        "thinking_default": {"type": "boolean"},
        "capability_profile": {"type": "object"}
      },
      "not": {
        "anyOf": [
          {"required": ["cost"]},
          {"required": ["api_key"]},
          {"required": ["api_keys"]},
          {"required": ["base_url"]},
          {"required": ["secret"]},
          {"required": ["token"]}
        ]
      },
      "additionalProperties": true
    },
    "offering": {
      "type": "object",
      "required": [
        "offering_id",
        "provider_id",
        "model_id",
        "enabled",
        "configuration"
      ],
      "properties": {
        "offering_id": {"$ref": "#/$defs/identifier"},
        "provider_id": {"$ref": "#/$defs/identifier"},
        "model_id": {"$ref": "#/$defs/identifier"},
        "enabled": {"type": "boolean"},
        "configuration": {"$ref": "#/$defs/configuration"},
        "provenance": {"type": "object"}
      },
      "additionalProperties": true
    },
    "route": {
      "type": "object",
      "required": ["model_id", "offering_ids", "strategy"],
      "properties": {
        "model_id": {"$ref": "#/$defs/identifier"},
        "offering_ids": {
          "allOf": [
            {"$ref": "#/$defs/uniqueIdentifiers"},
            {"minItems": 1}
          ]
        },
        "strategy": {"const": "score"}
      },
      "additionalProperties": true
    }
  }
}
