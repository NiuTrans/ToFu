{
  "contract": "tofu.durable-worker-runtime/v1",
  "capacityResource": "TOFU_AGENT_WORKERS",
  "processCapability": "task_workers",
  "controlScope": "automations:work",
  "workerLeaseMilliseconds": 60000,
  "heartbeatIntervalMilliseconds": 20000,
  "failureBackoffMilliseconds": 1000,
  "actionWaitMilliseconds": 1000,
  "horizonReanchorMilliseconds": 60000,
  "claimWake": "read-only worker_job.claim_horizon first; worker_job.claim_next only when it answers 0; then sleep until that horizon, a committed claimWakeOperations command in this process, or a settled claim; no idle poll",
  "claimWakeOperations": [
    "automation.definition.update",
    "automation.run.admit",
    "automation.run.approve",
    "automation.run.cancel",
    "turn.attempt.start",
    "worker_job.defer",
    "worker_job.enqueue",
    "worker_job.request_cancel",
    "turn.attempt.dispatch_worker"
  ],
  "extensionKey": "tofu_durable_workers",
  "threadNamePrefix": "tofu-durable",
  "queueReceipts": "no-idle-claim-receipts",
  "shutdown": "revoke-dispatch-await-effects-then-defer-owned-claim"
}
