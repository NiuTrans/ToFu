{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tofu.local/contracts/local_model_artifacts_v1.schema.json",
  "title": "Admitted local model artifacts",
  "description": "Public model facts reuse model-routing admission. Artifact pins describe downloadable bytes, not an enabled provider or permission to invoke a model.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "creators", "artifacts"],
  "properties": {
    "contract_version": {"const": "tofu.local-model-artifacts/v1"},
    "creators": {
      "type": "array",
      "items": {"$ref": "https://tofu.local/contracts/model_routing_v2.schema.json#/$defs/creator"}
    },
    "artifacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifact"}
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "model", "source", "execution"],
      "properties": {
        "artifact_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "not": {"pattern": "\\s"}},
        "model": {"$ref": "https://tofu.local/contracts/model_routing_v2.schema.json#/$defs/model"},
        "source": {"$ref": "#/$defs/source"},
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["backend", "architecture", "scoring", "weight_dtype"],
          "properties": {
            "backend": {"const": "transformers"},
            "architecture": {"const": "Qwen3ForCausalLM"},
            "scoring": {"const": "qwen3_yes_no"},
            "weight_dtype": {"const": "bfloat16"}
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "repository", "revision", "license", "files"],
      "properties": {
        "kind": {"const": "huggingface_safetensors"},
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$", "not": {"pattern": "\\s"}},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$", "maxLength": 40},
        "license": {"type": "string", "minLength": 1},
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "bytes", "sha256"],
            "properties": {
              "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$", "not": {"pattern": "\\s"}},
              "bytes": {"type": "integer", "minimum": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "maxLength": 64}
            }
          }
        }
      }
    }
  }
}
