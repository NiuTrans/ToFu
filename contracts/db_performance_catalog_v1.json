{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Offline database performance evidence v1",
  "description": "Scenario and environment are explicit comparison identities, not display labels. Unknown gates are null, never pass. Windows aggregate by median, not pooled request percentiles. Backend version is a recorded build label; import version is an operator release label. No universal aggregate is defined.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "scenario", "environment", "scope", "limits", "results"],
  "properties": {
    "format": {"const": "db-performance-catalog/v1"},
    "scenario": {"type": "object", "minProperties": 1},
    "environment": {"type": "object", "minProperties": 1},
    "scope": {"type": "string", "minLength": 1, "maxLength": 4096},
    "limits": {"type": "array", "maxItems": 100, "items": {"type": "string", "maxLength": 2048}},

    "source_metadata": {"type": "object"},
    "results": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "#/$defs/result"}}
  },
  "$defs": {
    "gate": {"type": ["boolean", "null"]},
    "window": {
      "type": "object", "additionalProperties": false,
      "required": ["label", "value", "gates", "raw"],
      "properties": {
        "label": {"type": "string", "minLength": 1, "maxLength": 128},
        "value": {"type": "number", "minimum": 0},
        "gates": {
          "type": "object", "required": ["correctness", "coverage", "budget"],
          "properties": {"correctness": {"$ref": "#/$defs/gate"}, "coverage": {"$ref": "#/$defs/gate"}, "budget": {"$ref": "#/$defs/gate"}}
        },
        "raw": {"type": "object"}
      }
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["backend", "backend_version", "metric", "unit", "direction", "aggregation", "windows"],
      "properties": {
        "backend": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
        "backend_version": {"type": "string", "minLength": 1, "maxLength": 256},
        "metric": {"type": "string", "minLength": 1, "maxLength": 128},
        "unit": {"type": "string", "minLength": 1, "maxLength": 128},
        "direction": {"enum": ["lower", "higher"]},
        "aggregation": {"const": "median_windows"},
        "windows": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"$ref": "#/$defs/window"}}
      }
    }
  }
}
