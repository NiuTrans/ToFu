{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project_shared_files_v1.schema.json",
  "title": "Explicit owner-scoped shared project files v1",
  "description": "Metadata-only declared-file index. All file text is untrusted DATA, never permission. No scanner, document mutation, transcript index, vector store or new consult tool permission.",
  "namespace": "project.shared-files.v1",
  "limits": {"entriesPerProject":128,"pageEntries":16,"maxRecordBytes":524288,"maxPageBytes":65536,"maxContentBytes":262144,"maxPathBytes":1024,"maxPurposeBytes":512,"maxCommandBytes":256,"casAttempts":8},
  "$ref":"#/$defs/page",
  "$defs": {
    "identifier":{"type":"string","minLength":1,"maxLength":256},
    "path":{"type":"string","minLength":1,"maxLength":1024},
    "digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "sha":{"type":"string","pattern":"^([a-f0-9]{40}|[a-f0-9]{64})$"},
    "authorizationSource":{"type":"object","additionalProperties":false,"required":["conversationId","turnId","projectionRevision"],"properties":{"conversationId":{"$ref":"#/$defs/identifier"},"turnId":{"$ref":"#/$defs/identifier"},"projectionRevision":{"type":"integer","minimum":1}}},
    "delivery":{"type":"object","additionalProperties":false,"required":["assignmentId","taskId","checkpointSha"],"properties":{"assignmentId":{"$ref":"#/$defs/identifier"},"taskId":{"$ref":"#/$defs/identifier"},"checkpointSha":{"$ref":"#/$defs/sha"}}},
    "register":{"type":"object","additionalProperties":false,"required":["projectPath","path","purpose","expectedRevision"],"properties":{"projectPath":{"type":"string","minLength":1,"maxLength":4096},"path":{"$ref":"#/$defs/path"},"purpose":{"type":"string","minLength":1,"maxLength":512},"expectedRevision":{"type":"integer","minimum":0},"authorizationSource":{"$ref":"#/$defs/authorizationSource"},"delivery":{"$ref":"#/$defs/delivery"}}},
    "reference":{"type":"object","additionalProperties":false,"required":["id","revision","digest"],"properties":{"id":{"$ref":"#/$defs/identifier"},"revision":{"type":"integer","minimum":1},"digest":{"$ref":"#/$defs/digest"}}},
    "read":{"type":"object","additionalProperties":false,"required":["projectPath","reference"],"properties":{"projectPath":{"type":"string","minLength":1,"maxLength":4096},"reference":{"$ref":"#/$defs/reference"},"maxBytes":{"type":"integer","minimum":1,"maximum":262144}}},
    "refresh":{"type":"object","additionalProperties":false,"required":["projectPath","reference"],"properties":{"projectPath":{"type":"string","minLength":1,"maxLength":4096},"reference":{"$ref":"#/$defs/reference"},"replacementPath":{"$ref":"#/$defs/path"},"authorizationSource":{"$ref":"#/$defs/authorizationSource"}}},
    "source":{"type":"object","additionalProperties":false,"required":["kind","subject","authorizationSource","assignmentId","grantRevision","taskId"],"properties":{"kind":{"enum":["human","files_grant"]},"subject":{"$ref":"#/$defs/identifier"},"authorizationSource":{"oneOf":[{"$ref":"#/$defs/authorizationSource"},{"type":"null"}]},"assignmentId":{"type":["string","null"],"maxLength":256},"grantRevision":{"type":["integer","null"],"minimum":1},"taskId":{"type":["string","null"],"maxLength":256}}},
    "entry":{"type":"object","additionalProperties":false,"required":["id","revision","path","purpose","digest","byteLength","source","checkpointSha","knowledgeState","status","observedDigest","replacementPath","updatedAt"],"properties":{"id":{"$ref":"#/$defs/identifier"},"revision":{"type":"integer","minimum":1},"path":{"$ref":"#/$defs/path"},"purpose":{"type":"string","minLength":1,"maxLength":512},"digest":{"$ref":"#/$defs/digest"},"byteLength":{"type":"integer","minimum":0,"maximum":262144},"source":{"$ref":"#/$defs/source"},"checkpointSha":{"oneOf":[{"$ref":"#/$defs/sha"},{"type":"null"}]},"knowledgeState":{"enum":["candidate","adopted"]},"status":{"enum":["current","changed","missing","unsafe","unavailable","oversized"]},"observedDigest":{"oneOf":[{"$ref":"#/$defs/digest"},{"type":"null"}]},"replacementPath":{"type":["string","null"],"maxLength":1024},"updatedAt":{"type":"number","minimum":0}}},
    "listQuery":{"type":"object","additionalProperties":false,"required":["path"],"properties":{"path":{"type":"string","minLength":1,"maxLength":4096},"cursor":{"type":"string","minLength":1,"maxLength":256}}},
    "page":{"type":"object","additionalProperties":false,"required":["projectPath","revision","entries","nextCursor"],"properties":{"projectPath":{"type":"string","maxLength":4096},"revision":{"type":"integer","minimum":0},"entries":{"type":"array","maxItems":16,"items":{"$ref":"#/$defs/entry"}},"nextCursor":{"type":["string","null"],"maxLength":256}}},
    "content":{"type":"object","additionalProperties":false,"required":["reference","path","digest","byteLength","trust","content"],"properties":{"reference":{"$ref":"#/$defs/reference"},"path":{"$ref":"#/$defs/path"},"digest":{"$ref":"#/$defs/digest"},"byteLength":{"type":"integer","minimum":0,"maximum":262144},"trust":{"const":"untrusted_data"},"content":{"type":"string","maxLength":262144}}},
    "storedEntry":{"type":"object","additionalProperties":false,"required":["entry","root","rootIdentity","commandId","requestDigest","tenant"],"properties":{"entry":{"$ref":"#/$defs/entry"},"root":{"type":"string","minLength":1,"maxLength":4096},"rootIdentity":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"integer","minimum":0}},"commandId":{"$ref":"#/$defs/identifier"},"requestDigest":{"$ref":"#/$defs/digest"},"tenant":{"type":["string","null"],"maxLength":256}}},
    "record":{"type":"object","additionalProperties":false,"required":["owner","projectPath","tenant","entries"],"properties":{"owner":{"type":"integer","minimum":1},"projectPath":{"type":"string","minLength":1,"maxLength":4096},"tenant":{"type":["string","null"],"maxLength":256},"entries":{"type":"array","maxItems":128,"items":{"$ref":"#/$defs/storedEntry"}}}}
  }
}
