    "workerPolicy": {"type": "object", "additionalProperties": false, "required": ["config"], "properties": {"config": {"type": "object", "additionalProperties": false, "properties": {"searchEnabled": {"type": "boolean"}, "fetchEnabled": {"type": "boolean"}, "codeExecEnabled": {"type": "boolean"}, "browserEnabled": {"type": "boolean"}, "desktopEnabled": {"type": "boolean"}, "humanGuidanceEnabled": {"type": "boolean"}, "schedulerEnabled": {"type": "boolean"}, "imageGenEnabled": {"type": "boolean"}, "autoApply": {"type": "boolean"}, "searchMode": {"type": "string", "maxLength": 4096}, "reasoningEffort": {"type": "string", "maxLength": 4096}, "thinkingDepth": {"type": "string", "maxLength": 4096}, "maxTokens": {"type": "integer", "minimum": 1}, "tools": {"type": "object"}, "enabledPlugins": {"type": "array", "items": {"type": "string"}}, "enabledMcpTools": {"type": "array", "items": {"type": "string"}}, "disabledTools": {"type": "array", "items": {"type": "string"}}, "systemPrompt": {"type": "string"}, "systemPromptMode": {"type": "string"}, "systemPromptBlocks": {"type": "object"}}}, "maxTotalTokens": {"type": "integer", "minimum": 1, "maximum": 2147483647}, "maxTotalModelRequests": {"type": "integer", "minimum": 1, "maximum": 2147483647}, "deadline": {"type": "number", "exclusiveMinimum": 0}, "maxConcurrent": {"type": "integer", "minimum": 1, "maximum": 4096, "deprecated": true, "description": "Legacy issued receipt data; ignored for concurrency admission."}, "continuation": {"$ref": "#/$defs/coordinatorContinuationPolicy"}, "requestBudgetId": {"$ref": "#/$defs/id"}, "maxTotalToolCalls": {"type": "integer", "minimum": 0, "maximum": 2147483647}}},
