    "batchWorker": {"type": "object", "additionalProperties": false, "required": ["recipientId", "brief", "model", "budget"], "properties": {"recipientId": {"$ref": "#/$defs/request/properties/recipientId"}, "brief": {"$ref": "#/$defs/request/properties/brief"}, "model": {"$ref": "#/$defs/request/properties/model"}, "budget": {"$ref": "#/$defs/request/properties/budget"}, "profile": {"$ref": "#/$defs/request/properties/profile"}, "dependencies": {"$ref": "#/$defs/request/properties/dependencies"}, "reworkOf": {"$ref": "#/$defs/request/properties/reworkOf"}}},
    "batchRequest": {"type": "object", "additionalProperties": false, "required": ["projectPath", "coordinatorId", "authorizationSource", "objective", "budget", "workers"], "properties": {"projectPath": {"$ref": "#/$defs/request/properties/projectPath"}, "coordinatorId": {"$ref": "#/$defs/request/properties/coordinatorId"}, "authorizationSource": {"$ref": "#/$defs/request/properties/authorizationSource"}, "objective": {"$ref": "#/$defs/request/properties/brief"}, "budget": {"$ref": "#/$defs/request/properties/budget"}, "workers": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/batchWorker"}}}},
    "batchRetry": {"type": "object", "additionalProperties": false, "required": ["projectPath", "batchId"], "properties": {"projectPath": {"$ref": "#/$defs/request/properties/projectPath"}, "batchId": {"$ref": "#/$defs/id"}}},
    "batchQuery": {"type": "object", "additionalProperties": false, "required": ["path", "commandId"], "properties": {"path": {"$ref": "#/$defs/listQuery/properties/path"}, "commandId": {"$ref": "#/$defs/id"}}},
