{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tofu.project-dispatch/v1",
  "description": "Human-authorized work, including current-request Coordinator delegation. Existing Turn/task/budget and workspace delivery owners execute and settle; synthetic inputs never create human authority.",
  "namespace": "project.dispatch.v1",
  "stopNamespace": "project.dispatch.stop.v1",
  "limits": {"assignmentsPerProject": 128, "batchesPerProject": 128, "workersPerBatch": 8, "casAttempts": 8, "maxRecordBytes": 4194304, "dependenciesPerAssignment": 8},
  "identityConfigKey": "_projectDispatchAdmission",
  "modelPhases": ["dispatch_intent", "settled", "voided"],
  "terminalToolPhases": ["not_entered", "executor_returned", "executor_exception"],
  "$defs": {
    "stop": {"type": "object", "additionalProperties": false, "required": ["owner", "conversationId", "occurredAt"], "properties": {"owner": {"type": "integer", "minimum": 1}, "conversationId": {"$ref": "#/$defs/id"}, "occurredAt": {"type": "number", "minimum": 0}}},
    "fileTool": {"enum": ["read_files", "write_file", "edit_file"]},
    "scopePath": {"type": "string", "minLength": 1, "maxLength": 1024},
    "profile": {"type": "object", "additionalProperties": false, "required": ["mode", "tools", "readPaths", "writePaths"], "properties": {"mode": {"enum": ["consult", "files", "project", "coordinator"]}, "tools": {"type": "array", "uniqueItems": true, "maxItems": 1024, "items": {"type": "string", "minLength": 1, "maxLength": 256}}, "readPaths": {"type": "array", "uniqueItems": true, "maxItems": 32, "items": {"$ref": "#/$defs/scopePath"}}, "writePaths": {"type": "array", "uniqueItems": true, "maxItems": 32, "items": {"$ref": "#/$defs/scopePath"}}, "maxToolCalls": {"type": "integer", "minimum": 0, "maximum": 2147483647}}, "allOf": [{"if": {"properties": {"mode": {"const": "consult"}}}, "then": {"properties": {"tools": {"maxItems": 0}, "readPaths": {"maxItems": 0}, "writePaths": {"maxItems": 0}, "maxToolCalls": {"const": 0}}}}, {"if": {"properties": {"mode": {"const": "files"}}}, "then": {"properties": {"tools": {"minItems": 1}, "readPaths": {"minItems": 1}, "maxToolCalls": {"minimum": 1}}}}, {"if": {"properties": {"mode": {"const": "files"}}}, "then": {"properties": {"tools": {"maxItems": 3, "items": {"$ref": "#/$defs/fileTool"}}}}}, {"if": {"properties": {"mode": {"const": "project"}}}, "then": {"properties": {"tools": {"minItems": 1}, "readPaths": {"const": ["."]}, "writePaths": {"const": ["."]}, "maxToolCalls": {"minimum": 1}}}}, {"if": {"properties": {"mode": {"const": "coordinator"}}}, "then": {"properties": {"tools": {"minItems": 1, "items": {"enum": ["todo_write", "list_conversations", "get_conversation", "get_project_assignment", "report_to_user", "delegate_project_work", "await_project_workers", "review_project_work", "cancel_project_work", "finish_project_request", "send_project_message", "get_project_messages", "consider_project_message", "search_tools", "execute_tools", "get_project_workers", "request_user_decision", "ask_human", "update_task_progress", "get_conversation_status", "control_conversation"]}}, "readPaths": {"maxItems": 0}, "writePaths": {"maxItems": 0}, "maxToolCalls": {"minimum": 1}}}}]},
    "reworkOf": {"type": "object", "additionalProperties": false, "required": ["assignmentId", "grantRevision", "resultRevision"], "properties": {"assignmentId": {"$ref": "#/$defs/id"}, "grantRevision": {"type": "integer", "minimum": 1}, "resultRevision": {"type": "integer", "minimum": 1}}},
    "dependency": {"type": "object", "additionalProperties": false, "required": ["assignmentId", "grantRevision", "resultRevision"], "properties": {"assignmentId": {"$ref": "#/$defs/id"}, "grantRevision": {"type": "integer", "minimum": 1}, "resultRevision": {"type": "integer", "minimum": 1}, "checkpointSha": {"$ref": "#/$defs/id"}}},
    "dependencies": {"type": "array", "uniqueItems": true, "maxItems": 8, "items": {"$ref": "#/$defs/dependency"}},
    "dependencyState": {"type": "object", "additionalProperties": false, "required": ["reference", "status", "reason"], "properties": {"reference": {"$ref": "#/$defs/dependency"}, "status": {"enum": ["ready", "waiting_review", "waiting_delivery", "invalid", "unknown"]}, "reason": {"enum": ["ready", "review_required", "delivery_required", "revoked", "scope_changed", "result_changed", "review_rejected", "stopped", "evidence_unavailable", "dependency_changed", "checkpoint_changed"]}}},
    "publication": {"type": ["object", "null"], "additionalProperties": false, "required": ["resultRevision", "grantRevision", "checkpointSha", "subject", "requestedAt"], "properties": {"resultRevision": {"type": "integer", "minimum": 1}, "grantRevision": {"type": "integer", "minimum": 1}, "checkpointSha": {"$ref": "#/$defs/id"}, "subject": {"$ref": "#/$defs/id"}, "requestedAt": {"type": "number", "minimum": 0}}},
    "publishRequest": {"type": "object", "additionalProperties": false, "required": ["projectPath", "assignmentId", "expectedRevision", "resultRevision", "expectedCheckpointSha"], "properties": {"expectedCheckpointSha": {"$ref": "#/$defs/id"}, "projectPath": {"type": "string", "minLength": 1, "maxLength": 4096}, "assignmentId": {"$ref": "#/$defs/id"}, "expectedRevision": {"type": "integer", "minimum": 1}, "resultRevision": {"type": "integer", "minimum": 1}}},
    "toolAttempt": {"type": "object", "additionalProperties": false, "required": ["root_task_id", "tool_ordinal", "task_id", "tool_call_id", "tool_name", "phase", "account_nonce"], "properties": {"root_task_id": {"$ref": "#/$defs/id"}, "task_id": {"$ref": "#/$defs/id"}, "tool_ordinal": {"type": "integer", "minimum": 1}, "tool_call_id": {"$ref": "#/$defs/id"}, "tool_name": {"type": "string", "minLength": 1, "maxLength": 256}, "phase": {"type": "string", "minLength": 1, "maxLength": 64}, "account_nonce": {"type": "string", "pattern": "^[0-9a-f]{32}$"}}},
    "delivery": {"type": ["object", "null"], "additionalProperties": false, "required": ["taskId", "status", "reason", "checkpointSha", "targetSha"], "properties": {"taskId": {"$ref": "#/$defs/id"}, "status": {"type": "string", "maxLength": 64}, "reason": {"type": "string", "maxLength": 1024}, "checkpointSha": {"type": "string", "maxLength": 256}, "targetSha": {"type": "string", "maxLength": 256}}},
    "historyPage": {"type": "object", "additionalProperties": false, "required": ["assignments", "olderCursor", "newerCursor"], "properties": {"assignments": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/historyRow"}}, "olderCursor": {"type": ["string", "null"], "maxLength": 512}, "newerCursor": {"type": ["string", "null"], "maxLength": 512}}},
    "historyRequest": {"type": "object", "additionalProperties": false, "required": ["projectPath", "coordinatorId", "recipientId", "brief"], "description": "List projection of request: only the fields a history row displays or drafts from. Exact commandId/assignmentId lookups keep the complete request.", "properties": {"projectPath": {"$ref": "#/$defs/request/properties/projectPath"}, "coordinatorId": {"$ref": "#/$defs/request/properties/coordinatorId"}, "recipientId": {"$ref": "#/$defs/request/properties/recipientId"}, "brief": {"$ref": "#/$defs/request/properties/brief"}, "profile": {"$ref": "#/$defs/request/properties/profile"}, "reworkOf": {"$ref": "#/$defs/request/properties/reworkOf"}, "dependencies": {"$ref": "#/$defs/request/properties/dependencies"}}},
    "historyRow": {"type": "object", "additionalProperties": false, "required": ["assignmentId", "request", "grantRevision", "revoked", "execution", "review", "canonicalDelivery"], "description": "A history-page view: the view with its request reduced to historyRequest and execution.result to the content preview.", "properties": {"assignmentId": {"$ref": "#/$defs/view/properties/assignmentId"}, "request": {"$ref": "#/$defs/historyRequest"}, "grantRevision": {"$ref": "#/$defs/view/properties/grantRevision"}, "revoked": {"$ref": "#/$defs/view/properties/revoked"}, "publication": {"$ref": "#/$defs/view/properties/publication"}, "delivery": {"$ref": "#/$defs/view/properties/delivery"}, "canonicalDelivery": {"$ref": "#/$defs/view/properties/canonicalDelivery"}, "dependencyStates": {"$ref": "#/$defs/view/properties/dependencyStates"}, "dispatch": {"$ref": "#/$defs/view/properties/dispatch"}, "execution": {"$ref": "#/$defs/view/properties/execution"}, "review": {"$ref": "#/$defs/view/properties/review"}}},
    "assignmentLookup": {"type": "object", "additionalProperties": false, "required": ["assignments", "olderCursor", "newerCursor"], "description": "An exact commandId/assignmentId read: complete views, independent of history cursors.", "properties": {"assignments": {"type": "array", "maxItems": 1, "items": {"$ref": "#/$defs/view"}}, "olderCursor": {"type": "null"}, "newerCursor": {"type": "null"}}},
    "listQuery": {"type": "object", "additionalProperties": false, "required": ["path"], "properties": {"path": {"type": "string", "minLength": 1, "maxLength": 4096}, "commandId": {"$ref": "#/$defs/id"}, "cursor": {"type": "string", "minLength": 1, "maxLength": 512}, "assignmentId": {"$ref": "#/$defs/id"}}, "allOf": [{"not": {"required": ["commandId", "cursor"]}}, {"not": {"required": ["assignmentId", "cursor"]}}, {"not": {"required": ["commandId", "assignmentId"]}}]},
    "id": {"type": "string", "minLength": 1, "maxLength": 256},
    "source": {"type": "object", "additionalProperties": false, "required": ["conversationId", "turnId", "projectionRevision"], "properties": {"conversationId": {"$ref": "#/$defs/id"}, "turnId": {"$ref": "#/$defs/id"}, "projectionRevision": {"type": "integer", "minimum": 1}}},
    "budget": {"type": "object", "additionalProperties": false, "required": [], "properties": {"maxTokens": {"type": "integer", "minimum": 1, "maximum": 2147483647}, "maxModelRequests": {"type": "integer", "minimum": 1, "maximum": 2147483647}, "deadline": {"type": "number", "exclusiveMinimum": 0}}},
    "request": {"type": "object", "additionalProperties": false, "required": ["projectPath", "coordinatorId", "recipientId", "authorizationSource", "brief", "model", "budget"], "properties": {"projectPath": {"type": "string", "minLength": 1, "maxLength": 4096}, "coordinatorId": {"$ref": "#/$defs/id"}, "recipientId": {"$ref": "#/$defs/id"}, "authorizationSource": {"$ref": "#/$defs/source"}, "brief": {"type": "string", "minLength": 1, "maxLength": 65536}, "model": {"$ref": "#/$defs/id"}, "budget": {"$ref": "#/$defs/budget"}, "profile": {"$ref": "#/$defs/profile"}, "reworkOf": {"$ref": "#/$defs/reworkOf"}, "dependencies": {"$ref": "#/$defs/dependencies"}, "delegation": {"$ref": "#/$defs/workerDelegation"}, "coordinatorWake": {"$ref": "#/$defs/coordinatorWake"}, "delegationInputHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "batchWorker": {"type": "object", "additionalProperties": false, "required": ["recipientId", "brief", "model", "budget"], "properties": {"recipientId": {"$ref": "#/$defs/request/properties/recipientId"}, "brief": {"$ref": "#/$defs/request/properties/brief"}, "model": {"$ref": "#/$defs/request/properties/model"}, "budget": {"$ref": "#/$defs/request/properties/budget"}, "profile": {"$ref": "#/$defs/request/properties/profile"}, "dependencies": {"$ref": "#/$defs/request/properties/dependencies"}, "reworkOf": {"$ref": "#/$defs/request/properties/reworkOf"}}},
    "batchRequest": {"type": "object", "additionalProperties": false, "required": ["projectPath", "coordinatorId", "authorizationSource", "objective", "budget", "workers"], "properties": {"projectPath": {"$ref": "#/$defs/request/properties/projectPath"}, "coordinatorId": {"$ref": "#/$defs/request/properties/coordinatorId"}, "authorizationSource": {"$ref": "#/$defs/request/properties/authorizationSource"}, "objective": {"$ref": "#/$defs/request/properties/brief"}, "budget": {"$ref": "#/$defs/request/properties/budget"}, "workers": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/batchWorker"}}}},
    "batchRetry": {"type": "object", "additionalProperties": false, "required": ["projectPath", "batchId"], "properties": {"projectPath": {"$ref": "#/$defs/request/properties/projectPath"}, "batchId": {"$ref": "#/$defs/id"}}},
    "batchQuery": {"type": "object", "additionalProperties": false, "required": ["path", "commandId"], "properties": {"path": {"$ref": "#/$defs/listQuery/properties/path"}, "commandId": {"$ref": "#/$defs/id"}}},
    "batch": {"type": "object", "additionalProperties": false, "required": ["id", "request", "assignmentIds"], "properties": {"id": {"$ref": "#/$defs/id"}, "request": {"$ref": "#/$defs/batchRequest"}, "assignmentIds": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}}},
    "batchDispatchResult": {"type": "object", "additionalProperties": false, "required": ["assignmentId", "status", "reason"], "properties": {"assignmentId": {"$ref": "#/$defs/id"}, "status": {"enum": ["accepted", "deferred", "aborted", "unknown"]}, "reason": {"enum": ["", "dispatch_unconfirmed"]}}, "allOf": [{"if": {"properties": {"status": {"const": "unknown"}}}, "then": {"properties": {"reason": {"const": "dispatch_unconfirmed"}}}, "else": {"properties": {"reason": {"const": ""}}}}]},
    "batchView": {"type": "object", "additionalProperties": false, "required": ["batchId", "request", "assignments"], "properties": {"batchId": {"$ref": "#/$defs/id"}, "request": {"$ref": "#/$defs/batchRequest"}, "assignments": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/view"}}, "dispatches": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/batchDispatchResult"}}}},
    "grant": {"type": "object", "additionalProperties": false, "required": ["subject", "tenant", "owner", "revision", "revoked", "createdAt"], "properties": {"bindingRevision": {"type": "integer", "minimum": 1}, "lifecycleVersion": {"const": 1}, "subject": {"$ref": "#/$defs/id"}, "tenant": {"type": ["string", "null"], "minLength": 1, "maxLength": 256}, "owner": {"type": "integer", "minimum": 1}, "revision": {"type": "integer", "minimum": 1}, "revoked": {"type": "boolean"}, "createdAt": {"type": "number", "minimum": 0}}},
    "assignment": {"type": "object", "additionalProperties": false, "required": ["id", "request", "grant", "execution", "review", "modelAttempts"], "properties": {"id": {"$ref": "#/$defs/id"}, "request": {"$ref": "#/$defs/request"}, "grant": {"$ref": "#/$defs/grant"}, "execution": {"type": ["object", "null"], "additionalProperties": false, "required": ["turnId", "attemptId"], "properties": {"turnId": {"$ref": "#/$defs/id"}, "attemptId": {"$ref": "#/$defs/id"}, "taskId": {"$ref": "#/$defs/id"}}}, "review": {"type": ["object", "null"], "additionalProperties": false, "required": ["decision", "note", "resultRevision"], "properties": {"decision": {"enum": ["accept", "rework", "reject"]}, "note": {"type": "string", "maxLength": 2048}, "resultRevision": {"type": "integer", "minimum": 1}, "actor": {"const": "coordinator"}}}, "modelAttempts": {"type": "array", "items": {"$ref": "#/$defs/modelAttempt"}}, "toolAttempts": {"type": "array", "items": {"$ref": "#/$defs/toolAttempt"}}, "publication": {"$ref": "#/$defs/publication"}, "toolReservations": {"type": "object", "additionalProperties": false, "required": ["rootTaskId", "accountNonce", "count"], "properties": {"rootTaskId": {"$ref": "#/$defs/id"}, "accountNonce": {"type": "string", "pattern": "^[a-f0-9]{32}$"}, "count": {"type": "integer", "minimum": 0, "maximum": 2147483647}}}, "settledModelUsage": {"$ref": "#/$defs/settledModelUsage"}, "settledToolUsage": {"$ref": "#/$defs/settledToolUsage"}}},
    "record": {"type": "object", "additionalProperties": false, "required": ["binding", "assignments"], "properties": {"binding": {"type": "object", "additionalProperties": false, "required": ["owner", "projectPath"], "properties": {"owner": {"type": "integer", "minimum": 1}, "projectPath": {"type": "string", "minLength": 1, "maxLength": 4096}}}, "assignments": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/assignment"}}, "batches": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/batch"}}, "coordinatorSettlements": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/coordinatorSettlement"}}, "requestBudgets": {"type": "array", "items": {"$ref": "#/$defs/coordinatorRequestBudget"}}}},
    "modelAttempt": {"type": "object", "additionalProperties": false, "required": ["root_task_id", "attempt_ordinal", "attempt_task_id", "reserved_tokens", "phase", "reported_tokens", "usage_complete", "account_observed_tokens", "account_nonce"], "properties": {"root_task_id": {"$ref": "#/$defs/id"}, "attempt_task_id": {"$ref": "#/$defs/id"}, "attempt_ordinal": {"type": "integer", "minimum": 1}, "reserved_tokens": {"type": "integer", "minimum": 0}, "phase": {"enum": ["dispatch_intent", "settled", "voided"]}, "reported_tokens": {"type": "integer", "minimum": 0}, "usage_complete": {"type": "boolean"}, "account_observed_tokens": {"type": "integer", "minimum": 0}, "account_nonce": {"type": "string", "pattern": "^[0-9a-f]{32}$"}}},
    "retry": {"type": "object", "additionalProperties": false, "required": ["projectPath", "assignmentId"], "properties": {"projectPath": {"type": "string", "minLength": 1, "maxLength": 4096}, "assignmentId": {"$ref": "#/$defs/id"}}},
    "revoke": {"type": "object", "additionalProperties": false, "required": ["projectPath", "assignmentId", "expectedRevision"], "properties": {"projectPath": {"type": "string", "minLength": 1, "maxLength": 4096}, "assignmentId": {"$ref": "#/$defs/id"}, "expectedRevision": {"type": "integer", "minimum": 1}}},
    "reviewRequest": {"type": "object", "additionalProperties": false, "required": ["projectPath", "assignmentId", "expectedRevision", "decision", "note", "resultRevision"], "properties": {"projectPath": {"type": "string", "minLength": 1, "maxLength": 4096}, "assignmentId": {"$ref": "#/$defs/id"}, "expectedRevision": {"type": "integer", "minimum": 1}, "decision": {"enum": ["accept", "rework", "reject"]}, "note": {"type": "string", "maxLength": 2048}, "resultRevision": {"type": "integer", "minimum": 1}}},
    "view": {"type": "object", "additionalProperties": false, "required": ["assignmentId", "request", "grantRevision", "revoked", "execution", "review", "canonicalDelivery"], "properties": {"assignmentId": {"$ref": "#/$defs/id"}, "request": {"$ref": "#/$defs/request"}, "grantRevision": {"type": "integer", "minimum": 1}, "revoked": {"type": "boolean"}, "publication": {"$ref": "#/$defs/publication"}, "delivery": {"$ref": "#/$defs/delivery"}, "canonicalDelivery": {"type": "boolean"}, "dependencyStates": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/dependencyState"}}, "dispatch": {"enum": ["accepted", "deferred", "aborted"]}, "execution": {"type": ["object", "null"], "additionalProperties": false, "required": ["turnId", "attemptId", "taskId", "status", "resultRevision", "result"], "properties": {"turnId": {"$ref": "#/$defs/id"}, "attemptId": {"$ref": "#/$defs/id"}, "taskId": {"type": "string", "maxLength": 256}, "status": {"type": "string", "maxLength": 64}, "resultRevision": {"type": ["integer", "null"]}, "result": {"type": "object"}}}, "review": {"type": ["object", "null"], "additionalProperties": false, "required": ["decision", "note", "resultRevision"], "properties": {"decision": {"enum": ["accept", "rework", "reject"]}, "note": {"type": "string", "maxLength": 2048}, "resultRevision": {"type": "integer", "minimum": 1}, "actor": {"const": "coordinator"}}}}},
    "admission": {"type": "object", "additionalProperties": false, "required": ["version", "owner", "tenant", "projectPath", "assignmentId", "revision", "recipientId"], "properties": {"version": {"const": 1}, "owner": {"type": "integer", "minimum": 1}, "tenant": {"type": ["string", "null"], "minLength": 1, "maxLength": 256}, "projectPath": {"type": "string", "minLength": 1, "maxLength": 4096}, "assignmentId": {"$ref": "#/$defs/id"}, "revision": {"type": "integer", "minimum": 1}, "recipientId": {"$ref": "#/$defs/id"}}},
