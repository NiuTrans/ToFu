    "reworkOf": {"type": "object", "additionalProperties": false, "required": ["assignmentId", "grantRevision", "resultRevision"], "properties": {"assignmentId": {"$ref": "#/$defs/id"}, "grantRevision": {"type": "integer", "minimum": 1}, "resultRevision": {"type": "integer", "minimum": 1}}},
    "dependency": {"type": "object", "additionalProperties": false, "required": ["assignmentId", "grantRevision", "resultRevision"], "properties": {"assignmentId": {"$ref": "#/$defs/id"}, "grantRevision": {"type": "integer", "minimum": 1}, "resultRevision": {"type": "integer", "minimum": 1}, "checkpointSha": {"$ref": "#/$defs/id"}}},
    "dependencies": {"type": "array", "uniqueItems": true, "maxItems": 8, "items": {"$ref": "#/$defs/dependency"}},
