{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tofu.local/contracts/model_routing_v2.schema.json",
  "title": "Tofu model routing v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "revision",
    "creators",
    "models",
    "providers",
    "provider_accesses",
    "connections",
    "credentials",
    "offerings",
    "deployments"
  ],
  "properties": {
    "contract_version": {"const": "tofu.model-routing/v2"},
    "revision": {"type": "integer", "minimum": 0},
    "creators": {
      "type": "array",
      "items": {"$ref": "#/$defs/creator"}
    },
    "models": {
      "type": "array",
      "items": {"$ref": "#/$defs/model"}
    },
    "providers": {
      "type": "array",
      "items": {"$ref": "#/$defs/provider"}
    },
    "provider_accesses": {
      "type": "array",
      "items": {"$ref": "#/$defs/providerAccess"}
    },
    "connections": {
      "type": "array",
      "items": {"$ref": "#/$defs/connection"}
    },
    "credentials": {
      "type": "array",
      "items": {"$ref": "#/$defs/credentialMetadata"}
    },
    "offerings": {
      "type": "array",
      "items": {"$ref": "#/$defs/offering"}
    },
    "deployments": {
      "type": "array",
      "items": {"$ref": "#/$defs/deployment"}
    },
    "migration": {"$ref": "#/$defs/migrationMetadata"}
  },
  "$defs": {
    "inferenceProfile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reasoning": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "support": {
              "enum": [
                "supported",
                "unsupported",
                "unknown"
              ]
            },
            "wire_format": {
              "type": "string", "minLength": 1, "maxLength": 64,
              "pattern": "^[A-Za-z0-9_.-]+$",
              "description": "Installed reasoning dialect key; execution validates the binding, never a model name."
            },
            "thinking_extra": {
              "type": "object", "maxProperties": 16,
              "propertyNames": {"type": "string", "minLength": 1, "maxLength": 64},
              "additionalProperties": {"type": ["string", "boolean", "number", "null"], "maxLength": 256}
            },
            "enabled_type": {
              "enum": [
                "enabled",
                "adaptive"
              ]
            },
            "effort_field": {
              "enum": [
                "effort",
                "reasoning_effort"
              ]
            },
            "supported_efforts": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_.-]+$"
              }
            },
            "default_effort": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9_.-]+$"
            },
            "disabled_effort": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9_.-]+$"
            },
            "can_disable": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "effort_map": {
              "type": "object",
              "maxProperties": 16,
              "propertyNames": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_.-]+$"
              },
              "additionalProperties": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_.-]+$"
              }
            },
            "preserve_history": {
              "enum": [
                "none",
                "replay",
                "clear_thinking_false",
                "keep_all"
              ]
            },
            "display": {
              "enum": [
                "summarized",
                "omitted"
              ]
            },
            "min_budget_tokens": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "max_budget_tokens": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "default_budget_tokens": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            }
          }
        },
        "sampling": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "omit": {
              "type": "array",
              "maxItems": 6,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "temperature",
                  "top_p",
                  "top_k",
                  "presence_penalty",
                  "frequency_penalty",
                  "stop"
                ]
              }
            },
            "temperature": {"anyOf": [{"enum": ["allow", "omit"]}, {"type": "number"}]},
            "omit_params": {
              "type": "array", "maxItems": 6, "uniqueItems": true,
              "items": {"enum": ["temperature", "top_p", "top_k", "presence_penalty", "frequency_penalty", "stop"]}
            },
            "enabled_temperature": {
              "type": "number"
            },
            "disabled_temperature": {
              "type": "number"
            },
            "min_temperature": {
              "type": "number"
            },
            "max_temperature": {
              "type": "number"
            }
          }
        },
        "responses": {
          "type": "object", "additionalProperties": false,
          "properties": {"feature_profile": {"enum": ["compatible", "openai", "codex"]}}
        },
        "features": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "additionalProperties": {
            "enum": [
              "supported",
              "unsupported",
              "unknown"
            ]
          }
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f]+$"
    },
    "identifierList": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "capabilities": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output", "currency", "unit"],
      "properties": {
        "input": {"type": "number", "minimum": 0},
        "output": {"type": "number", "minimum": 0},
        "currency": {"enum": ["USD", "CNY"]},
        "unit": {"const": "per_million_tokens"},
        "cache_read": {"type": "number", "minimum": 0},
        "cache_write": {"type": "number", "minimum": 0}
      }
    },
    "mediaPriceRate": {
      "description": "One official per-unit rate. unit is a media price unit of lib/model_info/capability_taxonomy MEDIA_PRICE_UNITS: per generated image, per second of generated video/audio, per generation request (one song or clip), per minute of input audio, or per million input characters.",
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "price"],
      "properties": {
        "unit": {"enum": ["per_image", "per_second", "per_request", "per_minute", "per_million_characters"]},
        "price": {"type": "number", "minimum": 0},
        "tier": {"description": "The size, quality, resolution or mode this rate applies to.", "type": "string", "minLength": 1, "maxLength": 128},
        "estimated": {"description": "True when the creator publishes the amount as a per-unit estimate while billing by tokens.", "type": "boolean"}
      }
    },
    "mediaPricing": {
      "description": "Official media-unit prices of an image, video, audio or speech Model. Token prices stay in pricing; the units a Model may use follow its model kind.",
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "rates"],
      "properties": {
        "currency": {"enum": ["USD", "CNY"]},
        "rates": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/mediaPriceRate"}}
      }
    },
    "mediaModalities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"enum": ["text", "image", "video", "audio"]}
    },
    "mediaProfile": {
      "description": "Officially documented generation and recognition constraints of a media Model. Every field is optional; absence means undocumented, never unsupported.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_modalities": {"$ref": "#/$defs/mediaModalities"},
        "output_modalities": {"$ref": "#/$defs/mediaModalities"},
        "sizes": {"description": "Accepted WIDTHxHEIGHT output sizes, or auto.", "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^([1-9][0-9]{1,4}x[1-9][0-9]{1,4}|auto)$"}},
        "aspect_ratios": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[1-9][0-9]{0,2}:[1-9][0-9]{0,2}$"}},
        "resolutions": {"description": "Named output resolutions such as 1K, 2K, 720p or 1080p.", "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 32}},
        "durations_s": {"description": "Selectable output lengths in seconds.", "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
          "items": {"type": "number", "exclusiveMinimum": 0, "maximum": 86400}},
        "max_outputs": {"description": "Maximum images or clips per request.", "type": "integer", "minimum": 1, "maximum": 1000},
        "native_audio": {"description": "Generated video carries a synchronized audio track.", "type": "boolean"},
        "voices": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 64}},
        "audio_formats": {"description": "Synthesized output formats, or accepted input formats for recognition.", "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9]{1,16}$"}},
        "max_input_chars": {"type": "integer", "minimum": 1},
        "max_audio_bytes": {"description": "Largest accepted input audio upload.", "type": "integer", "minimum": 1}
      }
    },
    "creator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["creator_id", "name"],
      "properties": {
        "creator_id": {"$ref": "#/$defs/identifier"},
        "name": {"type": "string", "minLength": 1, "maxLength": 256},
        "website": {"type": "string", "maxLength": 1024}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "creator_id", "model_id", "display_name", "capabilities",
        "context_window", "quality_rank"
      ],
      "properties": {
        "registration_state": {"enum": ["pending_metadata", "pending_validation", "ready", "disabled"]},
        "registration_issues": {"type": "array", "maxItems": 64, "items": {"type": "string", "maxLength": 256}},
        "registration_metadata": {
          "type": "object", "additionalProperties": false,
          "required": ["release_date", "checked_at", "source_urls"],
          "properties": {
            "field_sources": {"type": "object", "maxProperties": 7,
              "propertyNames": {"enum": ["release_date", "list_pricing", "inference_profile", "capabilities", "context_window", "media_pricing", "media_profile"]},
              "additionalProperties": {"type": "array", "minItems": 1, "maxItems": 8,
                "items": {"type": "string", "maxLength": 2048, "pattern": "^https://"}}},
            "release_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}(-[0-9]{2})?$"},
            "checked_at": {"type": "string", "format": "date"},
            "source_urls": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
              "items": {"type": "string", "maxLength": 2048, "pattern": "^https://"}}
          }
        },
        "inference_profile": {"$ref": "#/$defs/inferenceProfile"},
        "creator_id": {"$ref": "#/$defs/identifier"},
        "model_id": {"$ref": "#/$defs/identifier"},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 256},
        "capabilities": {"$ref": "#/$defs/capabilities"},
        "context_window": {"type": "integer", "minimum": 1},
        "quality_rank": {"type": "number"},
        "list_pricing": {"$ref": "#/$defs/pricing"},
        "official_pricing": {"$ref": "#/$defs/pricing"},
        "media_pricing": {"$ref": "#/$defs/mediaPricing"},
        "official_media_pricing": {"description": "Read-only projection of maintained media prices while media_pricing is absent; stripped on write.", "$ref": "#/$defs/mediaPricing"},
        "media_profile": {"$ref": "#/$defs/mediaProfile"},
        "official_media_profile": {"description": "Read-only projection of the maintained media profile while media_profile is absent; stripped on write.", "$ref": "#/$defs/mediaProfile"},
        "release_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$"},
        "lifecycle": {"enum": ["stable", "preview", "dated_snapshot", "retired"]}
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_id", "name", "scope"],
      "properties": {
        "provider_id": {"$ref": "#/$defs/identifier"},
        "name": {"type": "string", "minLength": 1, "maxLength": 256},
        "scope": {"enum": ["public", "owner"]},
        "brand": {"type": "string", "maxLength": 128},
        "website": {"type": "string", "maxLength": 1024}
      }
    },
    "quotaPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rpm": {"type": "integer", "minimum": 0},
        "tpm": {"type": "integer", "minimum": 0},
        "daily_tokens": {"type": "integer", "minimum": 0},
        "balance": {"type": "number", "minimum": 0},
        "currency": {"enum": ["USD", "CNY"]}
      }
    },
    "providerAccess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_access_id", "provider_id", "enabled", "quota_policy"],
      "properties": {
        "provider_access_id": {"$ref": "#/$defs/identifier"},
        "provider_id": {"$ref": "#/$defs/identifier"},
        "enabled": {"type": "boolean"},
        "quota_policy": {"$ref": "#/$defs/quotaPolicy"},
        "display_name": {"type": "string", "maxLength": 256}
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connection_id", "provider_access_id", "base_url", "protocol",
        "enabled", "priority", "extra_headers"
      ],
      "properties": {
        "inference_profile": {"$ref": "#/$defs/inferenceProfile"},
        "thinking_format": {"type": "string", "maxLength": 64},
        "responses_profile": {"enum": ["compatible", "openai", "codex"]},
        "connection_id": {"$ref": "#/$defs/identifier"},
        "provider_access_id": {"$ref": "#/$defs/identifier"},
        "base_url": {"type": "string", "minLength": 1, "maxLength": 2048},
        "protocol": {"enum": ["openai", "openai_responses", "anthropic", "local", "custom"]},
        "enabled": {"type": "boolean"},
        "priority": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "region": {"type": "string", "maxLength": 128},
        "gateway_namespace": {"type": "string", "maxLength": 256},
        "adapter": {"$ref": "#/$defs/desktopAdapter"},
        "extra_headers": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": {"type": "string", "maxLength": 2048}
        }
      }
    },
    "desktopAdapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id", "port"],
      "properties": {
        "agent_id": {"$ref": "#/$defs/identifier"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "credentialAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connection_ids", "models"],
      "properties": {
        "connection_ids": {"$ref": "#/$defs/identifierList"},
        "models": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/wireGrant"}
        }
      }
    },
    "credentialMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credential_id", "provider_access_id", "kind", "secret_reference",
        "key_hint", "enabled", "authorization", "quota_policy"
      ],
      "properties": {
        "credential_id": {"$ref": "#/$defs/identifier"},
        "provider_access_id": {"$ref": "#/$defs/identifier"},
        "kind": {"enum": ["api_key", "oauth", "local_identity", "subscription"]},
        "secret_reference": {
          "type": "string", "maxLength": 256,
          "description": "Owner/tenant-scoped encrypted secret reference. Delete and prune must retain references in the current aggregate, including disabled credentials, within the cleanup transaction. Caller prune references are additional retention pins."
        },
        "key_hint": {"type": "string", "maxLength": 64},
        "enabled": {"type": "boolean"},
        "authorization": {"$ref": "#/$defs/credentialAuthorization"},
        "quota_policy": {"$ref": "#/$defs/quotaPolicy"}
      }
    },
    "modelRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["creator_id", "model_id"],
      "properties": {
        "creator_id": {"$ref": "#/$defs/identifier"},
        "model_id": {"$ref": "#/$defs/identifier"}
      }
    },
    "wireGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["creator_id", "model_id"],
      "properties": {
        "creator_id": {"$ref": "#/$defs/identifier"},
        "model_id": {"$ref": "#/$defs/identifier"},
        "excluded_wire_model_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        }
      }
    },
    "offering": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offering_id", "provider_access_id", "identity_state", "enabled",
        "capabilities", "context_window", "priority"
      ],
      "properties": {
        "inherited_model_fields": {
          "description": "Fields inherited from the referenced Model, refreshed on every authority normalization. Materialized values remain present for older readers. Omitted or empty preserves legacy explicit overrides. Pending identities retain local fallback values until a Model is bound; those fallbacks are not provider measurements.",
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"enum": ["capabilities", "context_window"]}
        },
        "inference_profile": {"$ref": "#/$defs/inferenceProfile"},
        "offering_id": {"$ref": "#/$defs/identifier"},
        "provider_access_id": {"$ref": "#/$defs/identifier"},
        "identity_state": {"enum": ["confirmed", "pending_identity"]},
        "model": {"$ref": "#/$defs/modelRef"},
        "pending_model_id": {"type": "string", "maxLength": 256},
        "enabled": {"type": "boolean"},
        "stale": {"type": "boolean"},
        "capabilities": {"$ref": "#/$defs/capabilities"},
        "context_window": {"type": "integer", "minimum": 1},
        "actual_pricing": {"$ref": "#/$defs/pricing"},
        "catalog_context_window": {
          "description": "Last admitted managed Codex catalog window. Refresh updates context only while it matches this baseline; differing owner overrides and unmarked legacy limits are preserved.",
          "type": "integer", "minimum": 1
        },

        "catalog_capabilities": {
          "description": "Last admitted managed Codex catalog capability list. Reconciliation replaces capabilities only when they still match this baseline; a differing value is an owner override. Older unmarked Offerings remain explicit.",
          "$ref": "#/$defs/capabilities"
        },
        "priority": {"type": "integer", "minimum": 0, "maximum": 1000000}
      },
      "allOf": [
        {
          "if": {"properties": {"identity_state": {"const": "confirmed"}}},
          "then": {"required": ["model"], "not": {"required": ["pending_model_id"]}},
          "else": {"required": ["pending_model_id"], "not": {"required": ["model"]}}
        }
      ]
    },
    "deployment": {
      "type": "object",
      "description": "An upstream request name, not an independent enablement control. ProviderAccess, Connection, Credential and Offering switches plus credential model grants control routing. Probe status and identity confidence are diagnostic evidence, not enablement prerequisites. Normalization discards the retired enabled input without changing those visible controls or grants.",
      "additionalProperties": false,
      "required": [
        "deployment_id", "offering_id", "connection_id", "wire_model_id",
        "identity_confidence", "probe_status", "priority"
      ],
      "properties": {
        "registration_issues": {"type": "array", "maxItems": 64, "items": {"type": "string", "maxLength": 256}},
        "inference_profile": {"$ref": "#/$defs/inferenceProfile"},
        "deployment_id": {"$ref": "#/$defs/identifier"},
        "offering_id": {"$ref": "#/$defs/identifier"},
        "connection_id": {"$ref": "#/$defs/identifier"},
        "wire_model_id": {"$ref": "#/$defs/identifier"},
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "extra_headers": {
          "type": "object",
          "maxProperties": 16,
          "additionalProperties": {"type": "string", "maxLength": 2048},
          "description": "Per-request-name routing headers, merged OVER the owning Connection's. A gateway can serve one wire spelling only when a selector header names its serving provider (aigc x-context-provider), while another spelling of the SAME Offering needs none: the selector belongs to the request name, not the account or the Connection. Credential-named and transport-reserved headers are rejected and stay on the encrypted Credential."
        },
        "enabled": {
          "type": "boolean",
          "deprecated": true,
          "writeOnly": true,
          "description": "Legacy v2 input only, accepted for saved documents and older clients. Discarded during normalization and never emitted or consulted for routing; use Offering enabled and credential model grants."
        },
        "identity_confidence": {"enum": ["high", "medium", "low", "pending"]},
        "probe_status": {
          "enum": ["passed", "failed", "unprobed", "stale"],
          "description": "Historical probe evidence only. Never gates a user-authorized route or changes a visible switch."
        },
        "priority": {"type": "integer", "minimum": 0, "maximum": 1000000}
      }
    },
    "migrationMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "migrated_at", "receipt_id"],
      "properties": {
        "source": {"type": "string", "maxLength": 128},
        "migrated_at": {"type": "number", "minimum": 0},
        "receipt_id": {"$ref": "#/$defs/identifier"},
        "context_repair_receipt_id": {"$ref": "#/$defs/identifier"}
      }
    }
  }
}
