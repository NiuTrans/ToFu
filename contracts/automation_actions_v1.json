{
  "schemaVersion": 1,
  "contract": "tofu.automation-actions/v1",
  "actions": [
    {
      "id": "task.show_time",
      "version": 1,
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "timezone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": []
      },
      "output": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "startedAt": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "timezone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "startedAt",
          "timezone",
          "text"
        ]
      },
      "effect": "presentation",
      "recovery": "replay",
      "requiredScopes": [
        "automations:execute"
      ]
    },
    {
      "id": "skills.check",
      "version": 1,
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "provider": {
            "enum": [
              "mtskills"
            ]
          },
          "names": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,159}(?![\\s\\S])"
            },
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true
          },
          "initialize": {
            "enum": [
              "baseline",
              "process"
            ]
          }
        },
        "required": [
          "provider",
          "names",
          "initialize"
        ]
      },
      "output": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "changed": {
            "type": "boolean"
          },
          "revisions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "skillId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "version": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "digest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
                },
                "sourceId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "required": [
                "skillId",
                "version",
                "digest",
                "sourceId"
              ]
            },
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true
          },
          "snapshotId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "baselineEstablished": {
            "type": "boolean"
          }
        },
        "required": [
          "changed",
          "revisions",
          "snapshotId",
          "baselineEstablished"
        ]
      },
      "effect": "read",
      "recovery": "replay",
      "requiredScopes": [
        "skills:read"
      ]
    },
    {
      "id": "skills.activate",
      "version": 1,
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "snapshotId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "snapshotId"
        ]
      },
      "output": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "snapshotId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "revisions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "skillId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "version": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "digest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
                },
                "sourceId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "required": [
                "skillId",
                "version",
                "digest",
                "sourceId"
              ]
            },
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true
          },
          "activated": {
            "type": "boolean"
          }
        },
        "required": [
          "snapshotId",
          "revisions",
          "activated"
        ]
      },
      "effect": "write",
      "recovery": "reconcile",
      "requiredScopes": [
        "skills:install"
      ]
    },
    {
      "id": "agent.run",
      "version": 1,
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "objective": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24000
          },
          "skillSnapshotId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "targetMcpIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true
          },
          "conversationPolicy": {
            "enum": [
              "new",
              "reuse"
            ]
          },
          "conversationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "objective",
          "conversationPolicy"
        ]
      },
      "output": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "conversationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "taskId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "turnId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "attemptId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "status": {
            "enum": [
              "queued",
              "running",
              "done",
              "failed",
              "cancelled"
            ]
          },
          "resultRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "conversationId",
          "taskId",
          "turnId",
          "attemptId",
          "status"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "done"
                }
              }
            },
            "then": {
              "required": [
                "resultRef"
              ]
            }
          }
        ]
      },
      "effect": "agent",
      "recovery": "reconcile",
      "requiredScopes": [
        "conversation.execute"
      ]
    },
    {
      "id": "flow.run",
      "version": 1,
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "definitionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "inputs": {
            "type": "object"
          }
        },
        "required": [
          "definitionId",
          "inputs"
        ]
      },
      "output": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "runId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "conversationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "status": {
            "enum": [
              "queued",
              "running",
              "done",
              "failed",
              "cancelled"
            ]
          },
          "resultRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "runId",
          "conversationId",
          "status"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "done"
                }
              }
            },
            "then": {
              "required": [
                "resultRef"
              ]
            }
          }
        ]
      },
      "effect": "agent",
      "recovery": "reconcile",
      "requiredScopes": [
        "conversation.execute"
      ]
    },
    {
      "id": "condition.agent",
      "version": 1,
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "evidence": {
            "type": "object"
          }
        },
        "required": [
          "question",
          "evidence"
        ]
      },
      "output": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "matches": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "maxItems": 32
          }
        },
        "required": [
          "matches",
          "reason",
          "evidenceRefs"
        ]
      },
      "effect": "agent",
      "recovery": "reconcile",
      "requiredScopes": [
        "conversation.execute"
      ]
    },
    {
      "id": "result.verify",
      "version": 1,
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": [
                    "project_check",
                    "artifact",
                    "mcp_contract"
                  ]
                },
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "required": [
                "kind",
                "id"
              ]
            },
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true
          },
          "resultRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "checks",
          "resultRef"
        ]
      },
      "output": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "passed": {
            "type": "boolean"
          },
          "checks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "passed": {
                  "type": "boolean"
                },
                "evidenceRef": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "required": [
                "id",
                "passed",
                "evidenceRef"
              ]
            }
          }
        },
        "required": [
          "passed",
          "checks"
        ]
      },
      "effect": "read",
      "recovery": "replay",
      "requiredScopes": [
        "automations:execute"
      ]
    }
  ]
}
