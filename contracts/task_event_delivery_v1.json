      "storage_attempt": {
        "population": "sampled persistence attempts including failures",
        "start": "before persistence callback",
        "end": "callback success or exception handling returns"
      },
      "attempt_gap": {
        "population": "sampled attempts after first",
        "start": "previous attempt end",
        "end": "next attempt start; includes retry/control/repair waiting"
      },
      "persistence_wall": {
        "population": "sampled acknowledged batches",
        "start": "first worker dispatch",
        "end": "shared persistence waiter returns ACK including retry cleanup"
      },
      "ack_to_visibility": {
        "population": "sampled publication attempts",
        "start": "persistence waiter returns ACK",
        "end": "before visibility cursor update for this frame"
      },
      "visibility_update": {
        "population": "sampled publication attempts",
        "start": "before visibility cursor update",
        "end": "before publish callback or cursor failure"
      },
      "publish_callback": {
        "population": "sampled entered publish callbacks including failures",
        "start": "before entered publish callback",
        "end": "callback returns or raises"
      },
      "accept_to_publish": {
        "population": "sampled entered publish callbacks including failures",
        "start": "successful FIFO admission of this frame",
        "end": "callback returns or raises"
      },
      "flush_wall": {
        "population": "all barrier calls while profiler enabled including failures",
        "start": "before coordinator lock acquisition",
        "end": "barrier returns or raises"
      }
    },
    "attemptOutcomes": [
      "ok",
      "database_busy",
      "database_timeout",
      "database_unavailable",
      "authority_revoked",
