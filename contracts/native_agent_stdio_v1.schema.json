  "transport": {
    "framing": "one UTF-8 JSON object per newline",
    "stdin": "exclusive nonblocking pipe/socket; regular files rejected",
    "order": "one outstanding tool request; tool_result must match an already atomically published request; unsolicited and duplicate replies fail closed",
    "terminal": "one ordinary native task terminal event after resources settle and the input reader is joined",
    "permissions": [
      "read"
    ],
    "configuration": "configure frame schema; policy fields share the run-http-chat authority",
    "failures": "EOF, oversize, invalid response/schema or wrong request_id terminate the task; cancel or deadline aborts before next model round",
    "stdout": "exclusive pipe; tool requests fit PIPE_BUF and publish atomically with cancellation; regular files/sockets are not supported for requests",
    "control": "one bounded reactor reader observes cancel during provider and tool waits; one response slot; EOF closes the control carrier, failing a pending tool wait but permitting tool-free completion",
    "round_control": "Optional configure round_control=true requires a round_decision before each provider call and round_ack after raw settlement evidence; no implicit approval/refund; cancel keeps the input reader alive for settlement acknowledgments.",
    "usage_observation": "Returned evidence retains raw usage plus usage_observation: canonical observed token lower bound, completeness and explicit unsupported-count error. This is not pricing, reservation or refund authority.",
    "token_admission": "Optional explicitly selected local tiktoken tier with owned lazy encoder, bounds and native finite model account; omitted total_tokens is unbounded. Registered production routing/counter selection is not inferred.",
    "terminal_persistence": "Optional acknowledged frozen terminal candidate after native resource settlement. Retry is explicitly requested by host within the configured attempt bound; never repeats provider/tool execution. No terminal event before persistence ACK."
  },
  "notes": {
    "text_progress": "Optional configure text_progress=true emits sequenced content/reasoning text_delta frames and waits for text_ack from the explicit host consumer. Failed ACK stops provider execution. Published callbacks remain owned through ACK/EOF despite Stop; terminal persistence remains a separate required boundary.",
    "approval_control": "Explicit non-read tool control: host decision mints an existing native owner/parent/epoch/call/argument receipt; host rechecks and consumes the matching decision before invoking its callback. Missing policy refuses before provider effects. Pending callback joins on cancellation; failed policy is distinct from ordinary denial.",
    "round_preparation": "Explicit host preparation before each reservation. Enabled round requests carry bounded messages; approved decisions return prepared messages. Native byte/shape validation precedes dispatch and invalid admitted history settles NotDispatched. No route, credential, tool catalog or budget override.",
    "preparation_deadline": "Optional deadline_monotonic_ns is the inherited local Linux CLOCK_MONOTONIC deadline, captured before serialization/publication. It never resets per round. Preparation timeout signals and joins the existing worker before terminal acknowledgment; expired decisions are not sent into the terminal input carrier.",
    "progress_control": "Optional progress_control=true binds trusted post-tool observations after round settlement over the existing control slot; no history mirror, implicit evidence or detached callbacks.",
    "checkpoint_control": "Optional trusted load/begin/complete checkpoint policy reuses one control slot. Completed state serializes borrowed history with settled native token account totals/ordinal/completeness/policy. Restore matches account policy and ordinal before one-time Account.restore; missing, removed or changed profiles fail before HTTP.",
    "deadline_unix_ms": "Optional trusted application absolute UTC deadline. Native session clamps relative deadline_ms by remaining wall time observed once, subtracts observation-to-session delay, then uses its existing monotonic clock. Expired budget aborts without provider/tool effects. Checkpoint capture binds this original value; changed, added or removed recovery deadline refuses before another HTTP request.",
    "model_control": "Explicit model_control/model_counter selects one host shared-account authority instead of a native mirror. Rust counts admitted history once; reserve freezes output cap, dispatch ACK precedes HTTP and joined settlement preserves actual/unknown usage. Callback replies after their monotonic ACK expiry are not sent. Process loss joins before host pending-lease cleanup. Mixed local token_admission or checkpoint recovery is refused before effects until external recovery accounting is composed.",
    "shared_account_recovery": "Explicit checkpoint_shared_account with model_control captures one quiescent host invocation-root budget in the existing journal snapshot. SDK captures/restores before checkpoint completion/load acknowledgement; native checks owner/root and exact counter policy. Active children/pending attempts, changed policy and non-pristine restore refuse; unknown usage remains unknown. No native account mirror or automatic crash takeover.",
    "model_dispatch_headers": "Accepted dispatch only may return full per-attempt HTTP headers from the trusted host. Replace configured headers after joined credential resolution and dispatch intent; never retain them in checkpoint state or account receipts. Existing control frame bytes/deadline apply; wrong-action, malformed or forbidden transport headers refuse before HTTP. No credential vault or automatic refresh authority is created."
  },
