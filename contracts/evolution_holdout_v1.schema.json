{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tofu.local/contracts/evolution_holdout_v1.schema.json",
  "title": "Self-evolution holdout probe: a settled goal kept as regression evidence for gate decisions",
  "type": "object",
  "required": ["schema_version", "item_id", "domain", "statement", "criteria", "baseline_weight", "lineage", "created_at"],
  "properties": {
    "schema_version": {"const": 1},
    "item_id": {"type": "string", "maxLength": 160},
    "domain": {"type": "string", "minLength": 1, "maxLength": 80},
    "statement": {"type": "string", "minLength": 1, "maxLength": 4000},
    "criteria": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "object", "required": ["criterion_id", "kind", "params"], "properties": {"criterion_id": {"type": "string", "maxLength": 96}, "kind": {"enum": ["test_command", "artifact_check", "metric_threshold", "judge_panel", "falsification_protocol", "explicit_human"]}, "params": {"type": "object", "maxProperties": 16}, "weight": {"type": "number", "minimum": 0, "maximum": 1}}, "additionalProperties": false}},
    "baseline_weight": {"type": "number", "minimum": 0, "maximum": 1, "description": "Outcome weight of the original episode (success 1.0, partial 0.5, failure 0.0)."},
    "lineage": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "string", "maxLength": 160}},
    "created_at": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}
