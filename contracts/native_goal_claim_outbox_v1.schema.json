{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tofu.native-goal-claim-mutation/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "source_uuid",
    "request",
    "context_sha256",
    "claim",
    "updated_at_ms"
  ],
  "properties": {
    "format": {
      "enum": [
        "tofu.native-goal-claim-mutation/v1"
      ]
    },
    "source_uuid": {
      "type": "string",
      "format": "uuid"
    },
    "request": {
      "$ref": "native_goal_actor_claim_v1.schema.json"
    },
    "context_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "successor_run_id",
        "native_actor_claim"
      ],
      "properties": {
        "type": {
          "enum": [
            "execution_recovery_claim"
          ]
        },
        "successor_run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 517
        },
        "native_actor_claim": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format",
            "request_sha256",
            "target_attempt_id",
            "source_cursor",
            "account_version",
            "actors",
            "invoice"
          ],
          "properties": {
            "format": {
              "enum": [
                "tofu.native-goal-actor-claim/v1"
              ]
            },
            "request_sha256": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64
            },
            "target_attempt_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "source_cursor": {
              "type": "integer",
              "minimum": 1,
              "maximum": 18446744073709551615
            },
            "account_version": {
              "type": "integer",
              "minimum": 1,
              "maximum": 18446744073709551615
            },
            "actors": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "task_id",
                  "source_version",
                  "version"
                ],
                "properties": {
                  "task_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "source_version": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 18446744073709551615
                  },
                  "version": {
                    "type": "integer",
                    "minimum": 2,
                    "maximum": 18446744073709551615
                  }
                }
              }
            },
            "invoice": {
              "$ref": "native_agent_checkpoint_v1.schema.json#/properties/host_fee_projection/properties/wallet_settlement"
            }
          }
        }
      }
    },
    "updated_at_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    }
  }
}
