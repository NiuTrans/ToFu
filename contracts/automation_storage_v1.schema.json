{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tofu.automation-storage/v1",
  "oneOf": [
    {
      "$ref": "#/$defs/admit"
    },
    {
      "$ref": "#/$defs/advance"
    },
    {
      "$ref": "#/$defs/cancel"
    },
    {
      "$ref": "#/$defs/definitionUpdate"
    },
    {
      "$ref": "#/$defs/eventSettle"
    },
    {
      "$ref": "#/$defs/approve"
    },
    {
      "$ref": "#/$defs/projectUpdate"
    },
    {
      "$ref": "#/$defs/skillSourceUpdate"
    }
  ],
  "$defs": {
    "admit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_id",
        "tenant_id",
        "run_key",
        "run",
        "now_ms",
        "definition_key",
        "definition_revision",
        "definition_digest"
      ],
      "properties": {
        "user_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "tenant_id": {
          "type": "string",
          "maxLength": 256
        },
        "run_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "run": {
          "$ref": "#/$defs/run"
        },
        "now_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "definition_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "definition_revision": {
          "type": "integer",
          "minimum": 1
        },
        "definition_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "producer_fence": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "jobId",
                "workerId",
                "token"
              ],
              "properties": {
                "jobId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "workerId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "token": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              }
            }
          ]
        }
      }
    },
    "advance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_id",
        "tenant_id",
        "run_key",
        "run",
        "now_ms",
        "expected_version",
        "worker_id",
        "fencing_token"
      ],
      "properties": {
        "user_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "tenant_id": {
          "type": "string",
          "maxLength": 256
        },
        "run_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "run": {
          "$ref": "#/$defs/run"
        },
        "now_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "expected_version": {
          "type": "integer",
          "minimum": 1
        },
        "worker_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "fencing_token": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "run": {
      "type": "object",
      "required": [
        "contract",
        "id",
        "ownerId",
        "tenantId",
        "definitionId",
        "definitionRevision",
        "definitionDigest",
        "status",
        "snapshot",
        "actions",
        "steps",
        "stepOrder",
        "principal",
        "trigger",
        "triggerDigest",
        "automationChain",
        "jobId",
        "fence",
        "createdAt",
        "updatedAt",
        "deadlineAt"
      ],
      "properties": {
        "contract": {
          "const": "tofu.automation-run/v1"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,159}(?![\\s\\S])"
        },
        "ownerId": {
          "type": "integer",
          "minimum": 1
        },
        "tenantId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "definitionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "definitionRevision": {
          "type": "integer",
          "minimum": 1
        },
        "definitionDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "waiting_agent",
            "waiting_permission",
            "reconciliation_required",
            "cancelling",
            "succeeded",
            "failed",
            "cancelled"
          ]
        },
        "snapshot": {
          "type": "object"
        },
        "actions": {
          "type": "object"
        },
        "steps": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "approval": {
                "$ref": "#/$defs/approvalEvidence"
              }
            }
          }
        },
        "stepOrder": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string"
          }
        },
        "principal": {
          "type": "object"
        },
        "trigger": {
          "type": "object"
        },
        "triggerDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "automationChain": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string"
          }
        },
        "jobId": {
          "type": "string",
          "pattern": "^automation-run:[a-f0-9]{64}(?![\\s\\S])"
        },
        "fence": {
          "type": [
            "object",
            "null"
          ]
        },
        "createdAt": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740
        },
        "updatedAt": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740
        },
        "deadlineAt": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740
        }
      }
    },
    "cancel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_id",
        "tenant_id",
        "run_key",
        "now_ms",
        "request_id",
        "reason"
      ],
      "properties": {
        "user_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "tenant_id": {
          "type": "string",
          "maxLength": 256
        },
        "run_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "now_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}(?![\\s\\S])"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[^\u0000]+(?![\\s\\S])"
        }
      }
    },
    "definitionUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_id",
        "tenant_id",
        "definition_key",
        "expected_version",
        "request_id",
        "mode",
        "record",
        "first_due_ms",
        "now_ms",
        "definition_json",
        "actions_json",
        "actor_subject_id"
      ],
      "properties": {
        "user_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "tenant_id": {
          "type": "string",
          "maxLength": 256
        },
        "definition_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "expected_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}(?![\\s\\S])"
        },
        "mode": {
          "enum": [
            "publish",
            "retire",
            "pause"
          ]
        },
        "record": {
          "type": [
            "object",
            "null"
          ]
        },
        "first_due_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "now_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "definition_json": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 131072
        },
        "actions_json": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 524288
        },
        "actor_subject_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "enum": [
                  "pause",
                  "retire"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "record": {
                "type": "null"
              },
              "first_due_ms": {
                "type": "null"
              },
              "expected_version": {
                "minimum": 1
              },
              "definition_json": {
                "type": "string",
                "minLength": 2
              },
              "actions_json": {
                "type": "string",
                "minLength": 2
              }
            }
          },
          "else": {
            "properties": {
              "record": {
                "type": "object"
              },
              "definition_json": {
                "type": "string",
                "minLength": 2
              },
              "actions_json": {
                "type": "string",
                "minLength": 2
              }
            }
          }
        }
      ]
    },
    "clockJob": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "schemaVersion",
        "definitionId",
        "definitionRevision",
        "definitionDigest",
        "definitionKey",
        "publishedAtMs",
        "firstDueMs",
        "principal"
      ],
      "properties": {
        "contract": {
          "const": "tofu.automation-clock/v1"
        },
        "schemaVersion": {
          "const": 1
        },
        "definitionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,159}(?![\\s\\S])"
        },
        "definitionRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "definitionDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "definitionKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "publishedAtMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "firstDueMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "principal": {
          "type": "object"
        }
      }
    },
    "taskStartedContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenantId",
        "origin",
        "automationChain"
      ],
      "properties": {
        "tenantId": {
          "type": "string",
          "maxLength": 256
        },
        "origin": {
          "enum": [
            "human",
            "automation"
          ]
        },
        "automationChain": {
          "type": "array",
          "maxItems": 15,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "projectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "taskStartedJob": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "schemaVersion",
        "principal",
        "event"
      ],
      "properties": {
        "contract": {
          "const": "tofu.automation-event/v1"
        },
        "schemaVersion": {
          "const": 1
        },
        "principal": {
          "type": "object"
        },
        "event": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "occurredAt",
            "origin",
            "evidence",
            "automationChain"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^task-start:[a-f0-9]{64}$"
            },
            "kind": {
              "const": "task.started"
            },
            "occurredAt": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740
            },
            "origin": {
              "enum": [
                "human",
                "automation"
              ]
            },
            "automationChain": {
              "type": "array",
              "maxItems": 15,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              }
            },
            "projectId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "evidence": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "startedAt",
                "taskId",
                "attemptId",
                "turnId",
                "conversationId"
              ],
              "properties": {
                "startedAt": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740
                },
                "taskId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "attemptId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "turnId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "conversationId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              }
            }
          }
        },
        "delivery": {
          "$ref": "#/$defs/eventDeliveryCursor"
        }
      }
    },
    "eventDeliveryCursor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "afterKey",
        "processed"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "afterKey": {
          "type": "string",
          "maxLength": 512
        },
        "processed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "eventSettle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_id",
        "tenant_id",
        "job_id",
        "worker_id",
        "fencing_token",
        "expected_payload",
        "next_delivery",
        "mode",
        "error_kind",
        "now_ms"
      ],
      "properties": {
        "user_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "tenant_id": {
          "type": "string",
          "maxLength": 256
        },
        "job_id": {
          "type": "string",
          "pattern": "^automation-event:[a-f0-9]{64}$"
        },
        "worker_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "fencing_token": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "expected_payload": {
          "$ref": "#/$defs/taskStartedJob"
        },
        "next_delivery": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/eventDeliveryCursor"
            }
          ]
        },
        "mode": {
          "enum": [
            "advance",
            "succeeded",
            "cancelled",
            "failed"
          ]
        },
        "error_kind": {
          "type": "string",
          "maxLength": 128
        },
        "now_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "approve": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_id",
        "tenant_id",
        "run_key",
        "now_ms",
        "request_id",
        "expected_version",
        "step_id",
        "actor_principal",
        "arguments_json",
        "action_json"
      ],
      "properties": {
        "user_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "tenant_id": {
          "type": "string",
          "maxLength": 256
        },
        "run_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "now_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}(?![\\s\\S])"
        },
        "expected_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "step_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}(?![\\s\\S])"
        },
        "actor_principal": {
          "$ref": "#/$defs/approvalActor"
        },
        "arguments_json": {
          "type": "string",
          "minLength": 2,
          "maxLength": 524288
        },
        "action_json": {
          "type": "string",
          "minLength": 2,
          "maxLength": 524288
        }
      }
    },
    "approvalEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "requestDigest",
        "actorSubjectId",
        "approvedAt",
        "argumentsDigest",
        "actionDigest",
        "effectKey"
      ],
      "properties": {
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}(?![\\s\\S])"
        },
        "actorSubjectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "approvedAt": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "requestDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "argumentsDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "actionDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "effectKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "approvalActor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "subject_id",
        "owner_user_id",
        "tenant_id",
        "scopes"
      ],
      "properties": {
        "kind": {
          "enum": [
            "user",
            "system"
          ]
        },
        "subject_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "owner_user_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "tenant_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "scopes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "not": {
              "const": "admin"
            }
          }
        }
      }
    },
    "projectUpdate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "tenant_id": {
          "type": "string",
          "maxLength": 256
        },
        "project_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "expected_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "actor_subject_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "active": {
          "type": "boolean"
        },
        "now_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "user_id",
        "tenant_id",
        "project_key",
        "expected_version",
        "request_id",
        "actor_subject_id",
        "root",
        "label",
        "active",
        "now_ms"
      ]
    },
    "skillSourceUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_id",
        "tenant_id",
        "expected_version",
        "request_id",
        "actor_subject_id",
        "now_ms",
        "source_key",
        "environment",
        "active",
        "credential_ref",
        "credential_seal"
      ],
      "properties": {
        "user_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "tenant_id": {
          "type": "string",
          "maxLength": 256
        },
        "expected_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "actor_subject_id": {
