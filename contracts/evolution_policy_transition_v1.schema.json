{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tofu.local/contracts/evolution_policy_transition_v1.schema.json",
  "title": "Owned frozen policy preimage and exact effect/rollback projections",
  "type": "object",
  "required": [
    "schema_version",
    "user_id",
    "mutation_id",
    "mutation_fingerprint",
    "parent_version",
    "before_storage_version",
    "before",
    "after",
    "material_digest"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "user_id": {
      "type": "integer",
      "minimum": 1
    },
    "mutation_id": {
      "type": "string",
      "maxLength": 160
    },
    "mutation_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "parent_version": {
      "type": "integer",
      "minimum": 0
    },
    "before_storage_version": {
      "type": "integer",
      "minimum": 0
    },
    "before": {
      "type": "object",
      "description": "Validated by evolution_gate_policy_v1; absent authority captures compiled defaults."
    },
    "after": {
      "type": "object",
      "description": "Validated by evolution_gate_policy_v1; frozen installed projection."
    },
    "rollback": {
      "type": "object",
      "description": "Validated by evolution_gate_policy_v1; appended once before rollback CAS."
    },
    "rollback_from": {
      "type": "object"
    },
    "rollback_storage_version": {
      "type": "integer",
      "minimum": 1
    },
    "material_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false,
  "dependentRequired": {
    "rollback": [
      "rollback_from",
      "rollback_storage_version"
    ]
  }
}
