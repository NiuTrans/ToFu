{
  "format": "tofu.storage-performance-charter-policy/v1",
  "minimum_repeats": 2,
  "required_volumes": ["local", "fuse"],
  "required_engines": ["tofudb", "sqlite", "rawsqlite"],
  "scope": "Source-pinned operation measurements; application capacity is a separate required dimension. Unautomated charter clauses remain INSUFFICIENT even when their numeric subgates pass. PASS is not a power-loss certification or a deployment decision.",
  "dimensions": [
    {"id": "interactive_write", "owner": "docs/TOFUDB_WRITE_PATH_OVERLAY.md", "workloads": ["conversation_create_burst", "record_put_burst", "turn_append_burst", "turn_append_large", "event_log_append"], "metrics": [{"name": "p99_ms", "samples": "iterations"}], "baseline": "sqlite", "maximum_ratio": 1.0},
    {"id": "interactive_read", "owner": "docs/TOFUDB_EMBEDDED_RESPONSE.md", "workloads": ["conversation_open", "sidebar_list_page", "record_get_points"], "metrics": [{"name": "p50_ms"}], "baseline": "sqlite", "maximum_ratio": 1.0},
    {"id": "history_read", "owner": "docs/TOFUDB_JSON_MATERIALIZATION.md", "workloads": ["open_windowed_long_history", "sidebar_with_history", "transcript_bulk_hydration"], "metrics": [{"name": "p50_ms"}], "baseline": "sqlite", "maximum_ratio": 1.0, "unautomated_criteria": ["History-length scaling needs matched corpus sweeps; one scale cannot establish flat cost."]},
    {"id": "search", "owner": "docs/TOFUDB_SEARCH_POSTINGS.md", "workloads": ["conversation_search"], "metrics": [{"name": "p50_ms"}, {"name": "stabilization_seconds", "allow_zero": true}], "baseline": "sqlite", "maximum_ratio": 1.0},
    {"id": "mixed", "owner": "docs/STORAGE_PERFORMANCE_CHARTER.md", "workloads": ["mixed_80_10_10"], "metrics": [{"name": "ops_per_sec", "higher_is_better": true}], "baseline": "sqlite", "maximum_ratio": 1.0},
    {"id": "footprint", "owner": "docs/TOFUDB_ENTITY_PAGES.md", "kind": "footprint", "baseline": "sqlite", "maximum_ratio": 1.0},
    {"id": "engine_floor", "owner": "docs/STORAGE_PERFORMANCE_CHARTER.md", "workloads": ["conversation_create_burst", "record_put_burst", "turn_append_burst", "turn_append_large", "event_log_append", "conversation_open", "sidebar_list_page", "record_get_points", "open_windowed_long_history", "sidebar_with_history", "transcript_bulk_hydration", "conversation_search", "mixed_80_10_10", "concurrent_read", "swarm_write"], "metrics": [{"name": "p50_ms"}], "baseline": "rawsqlite", "maximum_ratio": 2.0, "note": "Raw SQLite is a narrower engine floor, not semantic equivalence. A named structural cause explains an over-budget observation but does not turn the numerical gate into PASS. Lifecycle process boundaries are explicitly excluded from this floor, not from maintenance."},
    {"id": "maintenance", "owner": "docs/TOFUDB_RECOVERY_ATTRIBUTION.md", "workloads": ["maintenance_reopen"], "metrics": [{"name": "mean_ms"}, {"name": "shutdown.mean_ms"}, {"name": "first_read.mean_ms"}], "baseline": "sqlite", "maximum_ratio": 1.0, "note": "Shutdown/checkpoint, reopen and first-read clocks are separate; no reopen-only lifecycle win."},
    {"id": "degraded_fuse", "owner": "docs/STORAGE_PERFORMANCE_CHARTER.md", "volumes": ["fuse"], "all_workloads": true, "metrics": [{"name": "p50_ms", "strict": true}, {"name": "p99_ms", "samples": "iterations"}], "baseline": "sqlite", "maximum_ratio": 1.0, "unautomated_criteria": ["Actual-volume locking and acknowledged process-crash recovery must be joined to the measured artifact; embedded abandon/reopen is not that evidence."]},
    {"id": "distracted_hardware", "owner": "docs/STORAGE_PERFORMANCE_CHARTER.md", "kind": "manual", "unautomated_criteria": ["Matched native idle-versus-CPU/memory-pressure P99 cohorts and an explicit no-blow-up budget are not yet emitted; a stress label or a SQLite ratio cannot substitute."]},
    {"id": "horizontal_reads", "owner": "docs/TOFUDB_EMBEDDED_PHASES.md", "kind": "manual", "unautomated_criteria": ["Writer-only versus writer-plus-N-reader scaling witnesses are not yet joined; concurrent-read throughput alone does not prove reads do not block the writer."]},
    {"id": "swarm_write_tail", "owner": "docs/TOFUDB_PIPELINE_CRITICAL_PATH.md", "workloads": ["swarm_write"], "metrics": [{"name": "writer_p99_ms", "samples": "writer_iterations"}, {"name": "reader_p99_ms", "samples": "reads_completed"}], "baseline": "sqlite", "maximum_ratio": 1.0},
    {"id": "conversation_capacity", "owner": "benchmarks/conversation_concurrency_contract.json", "kind": "conversation", "note": "Reassess raw paired conversation legs; never trust a supplied passed boolean."}
  ]
}
