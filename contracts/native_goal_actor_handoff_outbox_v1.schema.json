{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tofu.native-goal-actor-handoff-mutation/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "source_uuid",
    "authorization",
    "actors",
    "context_sha256",
    "updated_at_ms"
  ],
  "properties": {
    "format": {
      "const": "tofu.native-goal-actor-handoff-mutation/v1"
    },
    "source_uuid": {
      "type": "string",
      "format": "uuid"
    },
    "authorization": {
      "$ref": "native_goal_actor_handoff_v1.schema.json"
    },
    "actors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_task_id",
          "source_version",
          "target_header"
        ],
        "properties": {
          "source_task_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "source_version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 18446744073709551615
          },
          "target_header": {
            "$ref": "native_agent_journal_v1.schema.json"
          }
        }
      }
    },
    "context_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    },
    "updated_at_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    }
  }
}
