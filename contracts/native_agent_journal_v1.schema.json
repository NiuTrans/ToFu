{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tofu.native-agent-journal/v1",
  "type": "object",
  "required": [
    "format",
    "owner_user_id",
    "task_id",
    "epoch",
    "binding",
    "next_round",
    "phase",
    "lease",
    "lease_generation"
  ],
  "properties": {
    "format": {
      "enum": [
        "tofu.native-agent-journal/v1"
      ]
    },
    "owner_user_id": {
      "type": "integer",
      "minimum": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "epoch": {
      "type": "string",
      "minLength": 1
    },
    "binding": {
      "type": "string",
      "minLength": 1
    },
    "next_round": {
      "type": "integer",
      "minimum": 0
    },
    "phase": {
      "enum": [
        "new",
        "completed",
        "inflight",
        "tools_pending",
        "terminal"
      ]
    },
    "lease": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "lease_generation": {
      "type": "integer",
      "minimum": 0
    },
    "writer_process": {
      "type": "object",
      "required": [
        "boot_id",
        "pid_namespace",
        "pid",
        "start_ticks"
      ],
      "properties": {
        "boot_id": {
          "type": "string",
          "minLength": 1
        },
        "pid_namespace": {
          "type": "integer",
          "minimum": 1
        },
        "pid": {
          "type": "integer",
          "minimum": 1
        },
        "start_ticks": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "wallet_settlement": {
      "type": "object"
    },
    "goal_actor_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_run_id",
        "source_cursor",
        "root_task_id",
        "target_attempt_id",
        "request_sha256"
      ],
      "properties": {
        "source_run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "source_cursor": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "root_task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "target_attempt_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "request_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        }
      }
    },
    "goal_actor_handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_task_id",
        "target_root_task_id",
        "request_sha256"
      ],
      "properties": {
        "target_task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "target_root_task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "request_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        },
        "witness_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        }
      }
    }
  },
  "additionalProperties": false
}
